    "about_introduce": {
      "type": "about-introduce",
      "blocks": {
        "a653e752-d2e2-4d29-b960-f964706f33f1": {
          "type": "introduce",
          "settings": {
            "image_intro": "shopify://shop_images/Picture2_8e5361be-4b24-4580-b661-0e8b4fa1cb46.jpg",
            "title_intro": "OUR STORY",
            "des_intro": "A ritual of purity, balance and nature",
            "content_intro": "Shudhi Herbals is a premium herbal wellness brand built on a simple idea — purify your skin, cleanse your aura. Our first creation, the Negativity Removal Cleansing Bar, is handmade in small batches from herbs and pure essential oils. [PLACEHOLDER — founder & heritage story] Every bar is made slowly, with care, to turn an everyday wash into a grounding ritual."
          }
        },
        "1bdc974c-d9e3-4e49-8dd4-02b7a9c4e479": {
          "type": "introduce",
          "settings": {
            "image_intro": "shopify://shop_images/Picture3_e7835f23-4fc8-4e46-9a14-8a66cdcf4fe6.jpg",
            "title_intro": "OUR INSPIRATION",
            "des_intro": "Shudhi Herbals is kind to your skin and to nature.",
            "content_intro": "We believe skin and spirit are deeply connected, so we keep our ingredients simple, natural and pure. [PLACEHOLDER — brand inspiration] Our cleansing bar is crafted from herbs and essential oils and left free of harsh chemicals — a calm, considered alternative to ordinary soap."
          }
        },
        "319b49ab-37fb-428e-8525-51734b576f6e": {
          "type": "introduce",
          "settings": {
            "image_intro": "shopify://shop_images/Picture5_5d5d5bb8-e321-4c9c-b48a-d50153ec6ae0.jpg",
            "title_intro": "OUR PHILOSOPHY",
            "des_intro": "",
            "content_intro": "We take only the best of what nature offers, and nothing it does not need. Each Negativity Removal Cleansing Bar is handmade in small batches, without harsh chemicals or additives, for a cleanse that feels pure, balanced and grounding. We would rather make a little, made well, than a great deal made carelessly."
          }
        }
      },
