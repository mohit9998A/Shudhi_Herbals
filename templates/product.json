    "faq": {
      "type": "sh-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "What is the Negativity Removal Cleansing Bar?",
            "answer": "<p>The Negativity Removal Cleansing Bar is our hero handcrafted herbal cleansing bar, inspired by four generations of traditional herbal wisdom. It combines carefully selected herbs and essential oils with a mindful cleansing ritual.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Is it just a regular soap?",
            "answer": "<p>Not quite. It is designed as more than a cleansing bar — it is a daily ritual that brings together cleansing, intention, and traditional herbal wisdom.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "What makes Shudhi Herbals different?",
            "answer": "<p>Our approach combines handcrafted herbal formulations, traditional family wisdom, carefully selected ingredients, and our proprietary preparation ritual to create a distinctive wellness experience.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "What is the Shudhi Ritual™?",
            "answer": "<p>The Shudhi Ritual™ is our proprietary preparation philosophy, inspired by generations of family herbal wisdom. Selected ingredients undergo a unique multi-stage preparation process before becoming part of the final product.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "Why don’t you reveal the complete Shudhi Ritual™?",
            "answer": "<p>The ritual is part of our family’s proprietary tradition, refined and preserved across generations. We share the philosophy behind it while keeping the detailed methodology private.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Does the cleansing bar remove negative energy?",
            "answer": "<p>The concept of energetic cleansing is part of the traditional and wellness philosophy behind the product. It is intended to create a mindful cleansing experience and is not represented as a medical treatment or scientifically proven method of treating any medical or psychological condition.</p>"
          }
        }
      },
