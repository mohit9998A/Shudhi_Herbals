      </div>

    </div><!-- /.hov-auth__modal -->
  </div><!-- /.hov-auth__overlay -->

  <!-- HOV pincode / delivery-location modal (wired by assets/hov-location.js) -->
  <div class="hov-pincode-modal" id="hov-pincode-modal" data-state="hidden" role="dialog" aria-modal="true" aria-labelledby="hov-pincode-title">
    <div class="hov-pincode-modal__overlay" data-pincode-modal-close></div>
    <div class="hov-pincode-modal__card">
      <button type="button" class="hov-pincode-modal__close" data-pincode-modal-close aria-label="Close">&times;</button>
      <h2 class="hov-pincode-modal__title" id="hov-pincode-title">Check delivery to your area</h2>
      <p class="hov-pincode-modal__subtitle">Enter your pincode for accurate delivery estimates.</p>
      <input type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" class="hov-pincode-modal__input" data-pincode-input placeholder="e.g. 141001">
      <p class="hov-pincode-modal__error" data-pincode-error hidden></p>
      <button type="button" class="hov-pincode-modal__submit" data-pincode-submit>Confirm</button>
    </div>
  </div>

  <script src="{{ 'hov-auth.js' | asset_url }}" defer></script>
  <script src="{{ 'hov-cart-checkout.js' | asset_url }}" defer></script>
  <script src="{{ 'hov-location.js' | asset_url }}" defer></script>

  <!-- HOV Sidebar JS -->
  <script>
    (function() {
      'use strict';
      const sidebar  = document.getElementById('hov-sidebar');
      const closeBtn = document.getElementById('hov-sb-close');
      const overlay  = document.getElementById('hov-sb-overlay');
      const body     = document.body;
      if (!sidebar) return;

      function openSidebar() {
        sidebar.classList.add('is-open');
        body.classList.add('hov-sb-open');
        if (window.matchMedia('(max-width: 768px)').matches) {
          body.classList.add('activemenu_mobile');
        }
        sidebar.removeAttribute('aria-hidden');
        setTimeout(() => closeBtn?.focus(), 380);
      }

      function closeSidebar() {
        sidebar.classList.remove('is-open');
        body.classList.remove('hov-sb-open');
        body.classList.remove('activemenu_mobile');
        sidebar.setAttribute('aria-hidden', 'true');
        document.querySelector(
          '.hov-nav__hamburger, [data-sb-trigger]'
        )?.focus();
      }

      closeBtn?.addEventListener('click', closeSidebar);
      overlay?.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeSidebar();
      });

      document.querySelectorAll(
        '.hov-nav__hamburger, [data-sb-trigger]'
      ).forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          body.classList.contains('hov-sb-open')
            ? closeSidebar() : openSidebar();
        });
      });

      // Shop accordion
      const shopBtn = document.getElementById('hov-sb-shop-toggle');
      const shopSub = document.getElementById('hov-sb-shop-sub');
      shopBtn?.addEventListener('click', () => {
        const open = shopBtn.getAttribute('aria-expanded') === 'true';
        shopBtn.setAttribute('aria-expanded', String(!open));
        shopSub?.classList.toggle('is-open', !open);
      });

      // Wire sub-accordions (Staple, Health Supplements)
      document.querySelectorAll('.hov-sb__sub-accordion').forEach(btn => {
        btn.addEventListener('click', () => {
          const subId = 'hov-sb-' + btn.dataset.sub + '-sub';
          const subMenu = document.getElementById(subId);
          const isOpen = btn.classList.contains('is-open');
          document.querySelectorAll('.hov-sb__sub-accordion.is-open')
            .forEach(other => {
              if (other !== btn) {
                other.classList.remove('is-open');
                const otherId = 'hov-sb-' + other.dataset.sub + '-sub';
                document.getElementById(otherId)
                  ?.classList.remove('is-open');
              }
            });
          btn.classList.toggle('is-open', !isOpen);
          subMenu?.classList.toggle('is-open', !isOpen);
        });
      });

      // Active link
      const path = window.location.pathname;
      sidebar.querySelectorAll('.hov-sb__link[href]').forEach(a => {
        const href = a.getAttribute('href');
        const active = href === '/' ? path === '/' : path.startsWith(href);
        if (active) a.closest('.hov-sb__item')
          ?.classList.add('hov-sb__item--active');
      });

      // Counts
      function updateCounts() {
        try {
          const wlCid = document.documentElement.dataset.customerId;
          const wlKey = wlCid ? `hov_wishlist_${wlCid}` : 'hov_wishlist';
          const wl = JSON.parse(
            localStorage.getItem(wlKey) || '[]'
          );
          const wb = document.getElementById('hov-sb-wish-count');
          if (wb) {
            wb.textContent = wl.length;
            wb.style.display = wl.length ? 'flex' : 'none';
          }
        } catch(e) {}
        fetch('/cart.js').then(r => r.json()).then(cart => {
          const cb = document.getElementById('hov-sb-cart-count');
          if (cb) {
            cb.textContent = cart.item_count || 0;
            cb.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
        }).catch(() => {});
      }
      updateCounts();
      document.addEventListener('cart:updated', updateCounts);
      document.addEventListener('ajaxCart:updated', updateCounts);
      document.addEventListener('hov:wishlist:changed', updateCounts);
      document.addEventListener('click', (e) => {
        if (e.target.closest('[class*="cart"], [class*="add-to-cart"], [class*="wishlist"]')) {
          setTimeout(updateCounts, 800);
        }
      });

      // Login trigger
      sidebar.querySelector('[data-login-trigger]')
        ?.addEventListener('click', e => {
          if (typeof window.hovOpenLoginModal === 'function') {
            e.preventDefault();
            closeSidebar();
            setTimeout(window.hovOpenLoginModal, 380);
          }
        });

      window.addEventListener('pageshow', e => {
        if (e.persisted) closeSidebar();
      });

      window.hovOpenSidebar  = openSidebar;
      window.hovCloseSidebar = closeSidebar;
    })();
  </script>
  {% section 'hov-search-overlay' %}
  {% render 'hov-reel-popup' %}
</body>
</html>
