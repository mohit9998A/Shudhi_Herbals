   {%- comment -%} Body font — Shopify font library, self-hosted on Shopify's CDN and
       chosen in Theme settings > Typography. Replaces the Jost entry that used to ride
       along on the external Google Fonts <link> in snippets/engo-header-fonts.liquid;
       that link still loads Cormorant Garamond (headings) and Great Vibes (accent),
       which are deliberately unchanged.

       The :root override re-points --hov-font-primary, the one variable every body-text
       rule in assets/hov-typography.css already reads, so nothing else has to change.
       It must sit AFTER that stylesheet: both declare the variable on :root, so source
       order breaks the specificity tie. Headings read --font-heading and never this. {%- endcomment -%}
   {%- if settings.type_body_font -%}
     {%- liquid
       assign body_font = settings.type_body_font
       assign body_font_i   = body_font | font_modify: 'style',  'italic'
       assign body_font_300 = body_font | font_modify: 'weight', '300'
       assign body_font_500 = body_font | font_modify: 'weight', '500'
       assign body_font_600 = body_font | font_modify: 'weight', '600'
       assign body_font_700 = body_font | font_modify: 'weight', '700'
     -%}
     <style>
       {{ body_font | font_face: font_display: 'swap' }}
       {%- if body_font_i %}{{ body_font_i | font_face: font_display: 'swap' }}{% endif -%}
       {%- if body_font_300 %}{{ body_font_300 | font_face: font_display: 'swap' }}{% endif -%}
       {%- if body_font_500 %}{{ body_font_500 | font_face: font_display: 'swap' }}{% endif -%}
