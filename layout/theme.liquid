        </div>

        <!-- Social buttons -->
        <div class="hov-auth__social-btns">
          <a href="{{ routes.account_login_url }}" class="hov-auth__social-btn" data-social-login="google" aria-label="Continue with Google">
            <svg width="20" height="20" viewBox="0 0 24 24">
