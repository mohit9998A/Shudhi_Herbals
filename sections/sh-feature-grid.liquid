{%- comment -%}
  SHUDHI — Feature grid (icon / label / description)

  One component, instantiated three times on the Our Story page: "Our Philosophy"
  (3-up, ringed icons, descriptions), "Handmade With Purpose" (6-up, bare icons,
  labels only) and "More Than a Soap" (6-up, bare icons, descriptions). Every
  difference between the three is a setting, so they cannot drift apart the way
  three copied sections would — and a fourth band costs a template entry.

  `scheme` writes data-scheme on the root and does nothing else. The dark/light
  flip is a single token swap on .sh-fgrid in shudhi-home.css (§18), never a
  duplicated rule per element. It is deliberately independent of `bg`: the scheme
  picks the ink/rule/accent contrast family, the colour setting picks the surface,
  so retinting a band cannot silently break the pairing that was audited.

  The heading is split plain/gold exactly as sh-story-hero.liquid:48 splits its
  h1 — merchant-editable emphasis without opening a rich-text hole. Both halves
  are optional, and with neither set no <h2> is emitted at all: two of the three
  bands are eyebrow-only, and an empty heading would be a hole in the document
  outline for anyone navigating by headings.
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- comment -%} The id is a setting, never a literal — this section renders three
    times on Our Story. Shopify's own wrapper id (shopify-section-template--<theme_id>__<key>)
    carries a theme id that changes on every duplicate/publish, so nothing in the
    theme can link to it reliably. {%- endcomment -%}
<section class="sh sh-fgrid sh-fgrid--cols-{{ s.columns }}{% if s.show_circle %} sh-fgrid--ring{% endif %}"
         {%- if s.anchor_id != blank %} id="{{ s.anchor_id | handle }}"{% endif %}
         data-scheme="{{ s.scheme }}"
         {%- if s.bg != blank %} style="--sh-fgrid-bg:{{ s.bg }};"{% endif %}>

  {%- comment -%} The dark bands sit over a blurred plant photo in the reference.
      With no image the section's flat colour is the whole background, so the
      scrim is rendered only where there is something to scrim. {%- endcomment -%}
  {%- if s.bg_image != blank -%}
    {%- assign bg_h = 2000 | divided_by: s.bg_image.aspect_ratio | round -%}
    <img class="sh-fgrid__bg" src="{{ s.bg_image | image_url: width: 2000 }}" alt=""
         width="2000" height="{{ bg_h }}" loading="lazy" decoding="async">
    <div class="sh-fgrid__scrim"></div>
  {%- endif -%}

  <div class="sh-wrap">

    {%- if s.eyebrow != blank or s.heading != blank or s.heading_em != blank -%}
      <div class="sh-fgrid__head"{% if s.animate %} data-reveal{% endif %}>
        {%- comment -%} Two of the three bands on Our Story are eyebrow-only by
            design, and there the eyebrow IS the band's title — centred, gold,
            sitting above the grid. Emitting it as a <div> in that case would
            leave those bands out of the document outline entirely, filing their
            items under the previous band's <h2> (WCAG 1.3.1). So the eyebrow is
            promoted to the heading element exactly when there is no other
            heading to take the job. Visually identical either way: .sh-eyebrow
            carries the whole look and .sh-fgrid__eyebrow re-asserts the sans
            face, which `.sh h1..h6` (:145) would otherwise force to serif. {%- endcomment -%}
        {%- if s.eyebrow != blank -%}
          {%- if s.heading == blank and s.heading_em == blank -%}
            <h2 class="sh-fgrid__eyebrow sh-eyebrow">{{ s.eyebrow }}</h2>
          {%- else -%}
            <div class="sh-fgrid__eyebrow sh-eyebrow">{{ s.eyebrow }}</div>
          {%- endif -%}
        {%- endif -%}
        {%- if s.heading != blank or s.heading_em != blank -%}
          <h2 class="sh-fgrid__title sh-serif">
            {{- s.heading }}{% if s.heading_em != blank %} <em>{{ s.heading_em }}</em>{% endif -%}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} role="list" is load-bearing, not noise: the .sh reset sets
        `list-style: none` on every ul, and Safari/VoiceOver drops list semantics
        from an unstyled-marker list — the count ("6 items") goes with it. {%- endcomment -%}
    <ul class="sh-fgrid__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="sh-fgrid__item"{% if s.animate %} data-reveal{% endif %} {{ block.shopify_attributes }}>
          <span class="sh-fgrid__icon">{% render 'sh-icon', name: block.settings.icon %}</span>
          <h3 class="sh-fgrid__label">{{ block.settings.title }}</h3>
          {%- if s.show_description and block.settings.description != blank -%}
            <p class="sh-fgrid__text">{{ block.settings.description }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% schema %}
{
  "name": "SH · Feature Grid",
  "class": "index-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Philosophy" },

    { "type": "header", "content": "Heading" },
    { "type": "paragraph", "content": "Optional. Leave both blank for an eyebrow-only band — no empty heading is rendered." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_em", "label": "Heading — gold words" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3",
      "info": "6 drops to 3 on tablet and 2 on phones; 4 drops straight to 2; 3 drops to 1 on phones.",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "6", "label": "6" } ] },
    { "type": "checkbox", "id": "show_circle", "label": "Ring around each icon", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show descriptions", "default": true,
      "info": "Off gives an icon-and-label row; the descriptions are kept, not deleted." },

    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image",
      "info": "Optional. Rendered blurred behind a scrim. Without one the band is the flat colour below." },

    { "type": "header", "content": "Appearance" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id",
      "info": "Optional. Lets another section link straight to this band with #your-id. Must be unique on the page." },
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "dark",
      "info": "Picks the text/rule/accent set. Set the surface with Background below.",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1b2411" },
    { "type": "checkbox", "id": "animate", "label": "Animate on scroll", "default": true }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "lotus", "label": "Lotus" },
        { "value": "flower", "label": "Flower" }, { "value": "sprout", "label": "Sprout" },
        { "value": "plant", "label": "Plant" }, { "value": "wheat", "label": "Wheat" },
        { "value": "mortar", "label": "Mortar & pestle" }, { "value": "drop", "label": "Drop" },
        { "value": "sun", "label": "Sun" }, { "value": "sparkle", "label": "Sparkle" },
        { "value": "face-sparkle", "label": "Glowing skin" }, { "value": "meditate", "label": "Meditate" },
        { "value": "hands-heart", "label": "Hands & heart" }, { "value": "hand", "label": "Hand" },
        { "value": "heart", "label": "Heart" }, { "value": "heart-check", "label": "Heart with check" },
        { "value": "search", "label": "Magnifier" }, { "value": "flask-line", "label": "Flask (fine)" },
        { "value": "badge", "label": "Badge" }, { "value": "recycle", "label": "Recycle" },
        { "value": "rabbit", "label": "Rabbit" } ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Purity" },
      { "type": "textarea", "id": "description", "label": "Description",
        "default": "We use only pure, natural ingredients—free from toxins and harsh chemicals." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "SH · Feature Grid", "blocks": [
    { "type": "feature", "settings": { "icon": "leaf",  "title": "Purity",  "description": "We use only pure, natural ingredients—free from toxins and harsh chemicals." } },
    { "type": "feature", "settings": { "icon": "lotus", "title": "Balance", "description": "Inspired by Ayurveda, our formulations balance body, mind, and spirit." } },
    { "type": "feature", "settings": { "icon": "wheat", "title": "Nature",  "description": "We honor nature's power with sustainable practices and eco-friendly choices." } }
  ] } ]
}
{% endschema %}
