<script>
(function() {
  'use strict';

  const stage  = document.getElementById('hov-why-bleed');
  const canvas = document.getElementById('hov-why-fx');
  if (!stage || !canvas) return;

  const ctx = canvas.getContext('2d');
  let width, height, dpr;
  let leaves = [];
  let birds  = [];
  let running = false;
  let rafId   = null;

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  // ── RESIZE / SETUP ──────────────────────────────────
  function resize() {
    const rect = stage.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = rect.width;
    height = rect.height;
    canvas.width  = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width  = width + 'px';
    canvas.style.height = height + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function spawnLeaf() {
    const canopyLeft  = width * 0.10;
    const canopyRight = width * 0.90;
    const canopyTop   = height * 0.0;
    const canopyBot   = height * 0.50;

    return {
      x: canopyLeft + Math.random() * (canopyRight - canopyLeft),
      y: canopyTop  + Math.random() * (canopyBot - canopyTop),
      size: 5 + Math.random() * 5,
      rotation: Math.random() * Math.PI * 2,
      rotSpeed: (Math.random() - 0.5) * 0.04,
      vx: (Math.random() - 0.5) * 0.25,
      vy: 0.25 + Math.random() * 0.35,
      swayPhase: Math.random() * Math.PI * 2,
      swaySpeed: 0.015 + Math.random() * 0.01,
      swayAmp: 8 + Math.random() * 10,
      opacity: 0.85 + Math.random() * 0.15,
      color: ['#7CA15A', '#8FB86A', '#A8CC7E', '#C9A23A'][
        Math.floor(Math.random() * 4)
      ],
      life: 0,
      maxLife: 240 + Math.random() * 160
    };
  }

  function drawLeaf(l) {
    ctx.save();
    ctx.translate(l.x, l.y);
    ctx.rotate(l.rotation);
    ctx.globalAlpha = l.opacity * Math.max(0, 1 - l.life / l.maxLife);
    ctx.fillStyle = l.color;
    // simple leaf shape: pointed ellipse
    ctx.beginPath();
    ctx.ellipse(0, 0, l.size, l.size * 0.55, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // update leaf trajectory
  function updateLeaf(l) {
    l.life += 1;
    l.swayPhase += l.swaySpeed;
    l.x += l.vx + Math.sin(l.swayPhase) * 0.3;
    l.y += l.vy;
    l.rotation += l.rotSpeed;
    return l.life < l.maxLife && l.y < height + 20;
  }

  // ── BIRD FACTORY ────────────────────────────────────
  function spawnBird() {
    const fromLeft = Math.random() > 0.5;
    return {
      x: fromLeft ? -30 : width + 30,
      y: height * (0.06 + Math.random() * 0.18),
      vx: (fromLeft ? 1 : -1) * (0.35 + Math.random() * 0.25),
      wingPhase: Math.random() * Math.PI * 2,
      size: 6 + Math.random() * 4,
      opacity: 0.5 + Math.random() * 0.3
    };
  }

  function drawBird(b) {
    ctx.save();
    ctx.translate(b.x, b.y);
    ctx.globalAlpha = b.opacity;
    ctx.strokeStyle = '#5A4A38';
    ctx.lineWidth = 1.4;
    const wingY = Math.sin(b.wingPhase) * b.size * 0.5;
    ctx.beginPath();
    ctx.moveTo(-b.size, -wingY);
    ctx.quadraticCurveTo(0, wingY * 0.3, 0, 0);
    ctx.quadraticCurveTo(0, wingY * 0.3, b.size, -wingY);
    ctx.stroke();
    ctx.restore();
  }

  function updateBird(b) {
    b.x += b.vx;
    b.wingPhase += 0.18;
    return b.x > -50 && b.x < width + 50;
  }

  // ── MAIN LOOP ───────────────────────────────────────
  let lastLeafSpawn = 0;
  let lastBirdSpawn = 0;

  function tick(timestamp) {
    if (!running) return;
    ctx.clearRect(0, 0, width, height);

    // Spawn new leaves periodically (gentle, not a blizzard)
    if (timestamp - lastLeafSpawn > 900 && leaves.length < 9) {
      leaves.push(spawnLeaf());
      lastLeafSpawn = timestamp;
    }
    // Spawn birds rarely
    if (timestamp - lastBirdSpawn > 7000 && birds.length < 2) {
      birds.push(spawnBird());
      lastBirdSpawn = timestamp;
    }

    leaves = leaves.filter(updateLeaf);
    leaves.forEach(drawLeaf);

    birds = birds.filter(updateBird);
    birds.forEach(drawBird);

    rafId = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    resize();
    running = true;
    lastLeafSpawn = lastBirdSpawn = performance.now();
    rafId = requestAnimationFrame(tick);
  }

  function stop() {
    running = false;
    if (rafId) cancelAnimationFrame(rafId);
    ctx.clearRect(0, 0, width, height);
  }

  // ── LIFECYCLE ──
  resize();
  window.addEventListener('resize', resize);
  window.addEventListener('load', resize);

  if (!reduceMotion) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        entry.isIntersecting ? start() : stop();
      });
    }, { threshold: 0.15 });
    observer.observe(stage);
  }

})();
</script>

