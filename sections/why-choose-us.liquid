<style>
.hov-why {
  background: linear-gradient(180deg, #FAF6EE 0%, #F3EEE0 100%);
  padding: 48px 0 64px; /* remove horizontal padding so the bleed div touches the edges */
  position: relative;
  overflow: hidden;
}

.hov-why__header {
  max-width: 720px;
  margin: 0 auto 24px;
  padding: 0 24px;
  text-align: center;
  position: relative;
  z-index: 2;
}

.hov-why__eyebrow {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  font-size: 12px; font-weight: 700; letter-spacing: 2.5px; color: #2D5A27;
  margin-bottom: 8px;
}
.hov-why__eyebrow-leaf--flip { transform: scaleX(-1); }
.hov-why__title {
  font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: #1A2E1A;
  margin: 0; font-family: var(--font-heading, serif);
}
.hov-why__title-accent { color: #C97D2A; }
.hov-why__divider { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 10px 0 12px; }
.hov-why__divider-line { width: 56px; height: 1px; background: #C8B89A; }
.hov-why__divider-mark { color: #C97D2A; font-size: 16px; }
.hov-why__subtitle { font-size: 14px; color: #666; line-height: 1.5; margin: 0; }

/* ── THE FULL-BLEED IMAGE ZONE ── */
.hov-why__bleed {
  position: relative;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  aspect-ratio: 1536 / 1024;

  background-image: url('{{ "whychoose.webp" | asset_url }}');
  background-size: 100% 100%;
  background-position: center;
  background-repeat: no-repeat;
  overflow: hidden;
}

@media (min-width: 1800px) {
  .hov-why__bleed {
    max-width: 1800px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
}

/* Scrim for card text legibility */
.hov-why__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(10, 20, 10, 0.18) 0%,
    rgba(10, 20, 10, 0.04) 30%,
    rgba(10, 20, 10, 0.10) 70%,
    rgba(10, 20, 10, 0.22) 100%
  );
}

.hov-why__fx {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

/* ── CARDS ── */
.hov-why__card {
  position: absolute;
  z-index: 3;
  transform: translate(-50%, -50%);
  width: 230px;
  background: rgba(255,255,255,0.97);
  border-radius: 16px;
  box-shadow:
    0 16px 40px rgba(0,0,0,0.22),
    0 0 0 1px rgba(0,0,0,0.04);
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  cursor: default;
}

.hov-why__card-badge {
  width: 28px; height: 28px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-bottom: 8px;
}
.hov-why__card--1 .hov-why__card-badge,
.hov-why__card--4 .hov-why__card-badge { background: #2D5A27; }
.hov-why__card--2 .hov-why__card-badge { background: #C97D2A; }
.hov-why__card--3 .hov-why__card-badge { background: #8B6914; }

.hov-why__card h3 { font-size: 14px; font-weight: 700; color: #1A2E1A; margin: 0 0 4px; }
.hov-why__card p  { font-size: 11.5px; color: #555; line-height: 1.5; margin: 0; }

/* Symmetric two-band layout adjusted for wider full-bleed canvas */
.hov-why__card--1 {
  left: 10%; top: 35%;
  transform: translate(0%, -50%);
  align-items: flex-start; text-align: left;
}
.hov-why__card--2 {
  left: 33%; top: 20%;
}
.hov-why__card--3 {
  left: 67%; top: 20%;
}
.hov-why__card--4 {
  left: 90%; top: 35%;
  transform: translate(-100%, -50%);
  align-items: flex-end; text-align: right;
}

/* ── RESPONSIVE & BREAKPOINTS ── */
@media (max-width: 1024px) and (min-width: 769px) {
  .hov-why__card { width: 190px; padding: 13px 15px; }
  .hov-why__card--1 { left: 6%; top: 35%; }
  .hov-why__card--4 { left: 94%; top: 35%; }
  .hov-why__card--2 { left: 30%; top: 20%; }
  .hov-why__card--3 { left: 70%; top: 20%; }
}

@media (max-width: 768px) {
  .hov-why { padding: 40px 0 50px; }
  .hov-why__card { display: none; }

  .hov-why__mobile-cards {
    display: grid;
    gap: 14px;
    margin-top: 28px;
    padding: 0 20px; /* add padding so list has breathing room from viewport edge */
  }
  .hov-why__mobile-card {
    background: #FFF;
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .hov-why__mobile-card-content h3 {
    font-size: 14px;
    font-weight: 700;
    color: #1A2E1A;
    margin: 0 0 6px;
  }
  .hov-why__mobile-card-content p {
    font-size: 12px;
    color: #666;
    line-height: 1.5;
    margin: 0;
  }
  .hov-why__mobile-card--1 .hov-why__card-badge,
  .hov-why__mobile-card--4 .hov-why__card-badge { background: #2D5A27; }
  .hov-why__mobile-card--2 .hov-why__card-badge { background: #C97D2A; }
  .hov-why__mobile-card--3 .hov-why__card-badge { background: #8B6914; }
}

@media (min-width: 769px) {
  .hov-why__mobile-cards { display: none; }
}
</style>

