{%- comment -%}
  SHUDHI — The Five Ritual Stages

  Five arched stage cards in a row under The Ritual page hero, replacing the
  four-image "Core Ingredients" band on the live theme. Built to the reference:
  a centred tracked-serif heading with a gold ornament, then five cream pill
  cards — numbered green disc, uppercase title, arched portrait photo, gold line
  icon — joined by one gold hairline that runs behind the row.

  PORTABLE ON PURPOSE. The live ritual page was built from code this repo does
  not carry (sh-rhero / sh-rcore / shudhi-ritual.css), so this band touches
  nothing shared: its styles live in assets/shudhi-ritual-stages.css, its five
  glyphs are inlined below rather than added to snippets/sh-icon.liquid, and it
  only relies on the two files every live ritual band already loads —
  shudhi-story.css for the motion primitives and sh-story-motion.js to arm them.
  To port: copy this file, the CSS file and the five stage .webp files.

  MOTION is the house fails-open contract (see shudhi-story.css header): the
  resting state is the finished state; every pre-state sits under
  [data-sh-reveal].is-armed, which only the script writes, only when it holds
  the observer that clears it. The blur on arrival is the same treatment the
  live ritual bands use — the vanilla port of Magic UI's "blur-fade":
  opacity 0 + small rise + blur(6px) -> all cleared, one ease-out curve, once.

  IMAGES: each block has an image_picker; when it is empty the card falls back
  to the shipped photo for its icon, so the five presets render with no editor
  work at all. The asset names carry their original spelling and spaces
  ("Solar Vertilization.webp") — Liquid's asset_url encodes the space, and the
  theme already ships assets named this way ('Its a ritual.webp').
{%- endcomment -%}

{{ 'shudhi-story.css' | asset_url | stylesheet_tag }}
{{ 'shudhi-ritual-stages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="sh sh-rstages"
         {%- if s.anchor_id != blank %} id="{{ s.anchor_id | handle }}"{% endif %}
         {%- if s.animate %} data-sh-reveal{% endif %}
         style="--sh-rstages-bg:{{ s.bg }};">

  <div class="sh-wrap">

    <header class="sh-rstages__head">
      <h2 class="sh-rstages__title sh-serif" data-sh-fade style="--i:0">{{ s.heading }}</h2>
      <div class="sh-rstages__orn" data-sh-fade style="--i:1" aria-hidden="true">
        <i></i>
        <svg class="sh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 17c0-4.2 2.6-6.8 6.4-6.8 0 4.2-2.6 6.8-6.4 6.8Z"/><path d="M12 17c0-4.2-2.6-6.8-6.4-6.8 0 4.2 2.6 6.8 6.4 6.8Z"/><path d="M12 17v-5.2"/><path d="M12 8.6V6"/></svg>
        <i></i>
      </div>
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="sh-rstages__track">
        {%- comment -%} Decorative: the sequence is in the markup, this only joins it.
            data-sh-line grows it from the centre once the band is armed. {%- endcomment -%}
        <span class="sh-rstages__line" data-sh-line style="--i:1;--sh-line-sx:0;--sh-line-o:50% 50%" aria-hidden="true"></span>

        {%- comment -%} role="list": the .sh reset sets list-style:none, which drops
            list semantics — and the count — in Safari/VoiceOver. {%- endcomment -%}
        <ol class="sh-rstages__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- comment -%} Fallback photo is keyed on the icon, not the position, so a
                merchant who reorders the stages keeps every photo with its stage. {%- endcomment -%}
            {%- case b.icon -%}
              {%- when 'moon' -%}
                {%- assign fb = 'Lunar Conditioning.webp' -%}{%- assign fw = 1024 -%}{%- assign fh = 1536 -%}
              {%- when 'crystal' -%}
                {%- assign fb = 'Minral Resoanance infusion.webp' -%}{%- assign fw = 1024 -%}{%- assign fh = 1536 -%}
              {%- when 'geometry' -%}
                {%- assign fb = 'Geomatric Crystal Conditioning.webp' -%}{%- assign fw = 1024 -%}{%- assign fh = 1536 -%}
              {%- when 'waves' -%}
                {%- assign fb = 'Harmonic Resonance activation.webp' -%}{%- assign fw = 941 -%}{%- assign fh = 1672 -%}
              {%- else -%}
                {%- assign fb = 'Solar Vertilization.webp' -%}{%- assign fw = 1024 -%}{%- assign fh = 1536 -%}
            {%- endcase -%}

            <li class="sh-rstages__card" data-sh-fade style="--i:{{ forloop.index | plus: 1 }}" {{ block.shopify_attributes }}>
              <span class="sh-rstages__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>

              <h3 class="sh-rstages__name">
                <span class="sh-visually-hidden">Stage {{ forloop.index }}: </span>{{ b.title }}
              </h3>

              <span class="sh-rstages__media">
                {%- if b.image != blank -%}
                  <img src="{{ b.image | image_url: width: 640 }}"
                       alt="{{ b.title | escape }}"
                       width="640" height="{{ 640 | divided_by: b.image.aspect_ratio | round }}"
                       loading="lazy" decoding="async">
                {%- else -%}
                  <img src="{{ fb | asset_url }}"
                       alt="{{ b.title | escape }}"
                       width="{{ fw }}" height="{{ fh }}"
                       loading="lazy" decoding="async">
                {%- endif -%}
              </span>

              {%- comment -%} Same 24x24 grid, stroke and caps as snippets/sh-icon.liquid,
                  inlined so the band has no dependency on that snippet's revision. {%- endcomment -%}
              <span class="sh-rstages__icon" aria-hidden="true">
                <svg class="sh-icon sh-icon--{{ b.icon }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {%- case b.icon -%}
                    {%- when 'moon' -%}<path d="M12.8 3.6a8.4 8.4 0 1 0 7.6 12.1A7.2 7.2 0 0 1 12.8 3.6Z"/>
                    {%- when 'crystal' -%}<path d="M12 3.6 8.8 9.8 12 20.4l3.2-10.6L12 3.6Z"/><path d="m8.8 9.8-3.2 3.2 2.6 7.4"/><path d="m15.2 9.8 3.2 3.2-2.6 7.4"/><path d="M8.2 20.4h7.6"/>
                    {%- when 'geometry' -%}<path d="M12 3.6 19.3 7.8v8.4L12 20.4l-7.3-4.2V7.8L12 3.6Z"/><path d="M12 3.6v16.8"/><path d="m4.7 7.8 14.6 8.4"/><path d="M19.3 7.8 4.7 16.2"/>
                    {%- when 'waves' -%}<path d="M4 10.4v3.2"/><path d="M7.2 7.6v8.8"/><path d="M10.4 5.2v13.6"/><path d="M13.6 8.4v7.2"/><path d="M16.8 6.2v11.6"/><path d="M20 10.4v3.2"/>
                    {%- else -%}<circle cx="12" cy="12" r="4.2"/><path d="M12 3.8v2M12 18.2v2M3.8 12h2M18.2 12h2M6.2 6.2l1.4 1.4M16.4 16.4l1.4 1.4M17.8 6.2l-1.4 1.4M7.6 16.4l-1.4 1.4"/>
                  {%- endcase -%}
                </svg>
              </span>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

  </div>
</section>

{%- if s.animate -%}
  <script src="{{ 'sh-story-motion.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "SH · Ritual Stages",
  "class": "index-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Five Ritual Stages" },

    { "type": "header", "content": "Appearance" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id",
      "info": "Optional. Lets a button link straight to this band with #your-id. Must be unique on the page." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f4f2eb",
      "info": "Matches the cream of the ritual hero above it." },

    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "animate", "label": "Animate on scroll", "default": true,
      "info": "Turns off the heading, hairline and card entrance. The band still renders in full." }
  ],
  "blocks": [
    { "type": "stage", "name": "Stage", "settings": [
      { "type": "paragraph", "content": "Stages are numbered automatically in the order they appear here." },
      { "type": "text", "id": "title", "label": "Title", "default": "Solar Vitalization" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "sun", "options": [
        { "value": "sun", "label": "Sun" },
        { "value": "moon", "label": "Crescent moon" },
        { "value": "crystal", "label": "Crystal cluster" },
        { "value": "geometry", "label": "Sacred geometry" },
        { "value": "waves", "label": "Sound waves" } ] },
      { "type": "image_picker", "id": "image", "label": "Photo",
        "info": "Portrait, 4:5 or taller. Leave empty to use the built-in photo for the chosen icon (the five stage .webp files in Assets)." }
    ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "SH · Ritual Stages", "blocks": [
      { "type": "stage", "settings": { "icon": "sun",      "title": "Solar Vitalization" } },
      { "type": "stage", "settings": { "icon": "moon",     "title": "Lunar Conditioning" } },
      { "type": "stage", "settings": { "icon": "crystal",  "title": "Mineral Resonance Infusion" } },
      { "type": "stage", "settings": { "icon": "geometry", "title": "Geometric Crystal Conditioning" } },
      { "type": "stage", "settings": { "icon": "waves",    "title": "Harmonic Resonance Activation" } }
    ] }
  ]
}
{% endschema %}
