{{ 'fresh-carousel.css' | asset_url | stylesheet_tag }}
    <!-- <script src="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.min.js"></script>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.css">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick-theme.css"> -->
{% assign meta_images = product.metafields.custom.multiple_images_fresh_carousel.value %}
{% assign show_message = false %}

{% if template contains 'product' and meta_images != blank %}
  {% assign show_message = true %}
{% endif %}
<div class="img-text {% if show_message %} show_section{% else %}hide_section{% endif %}"  style="padding-top:{{section.settings.pd_tp }}px; padding-bottom:{{section.settings.pd_bp }}px;
    {% if section.settings.back_img %}
      background-image: url('{{ section.settings.back_img | img_url: "master" }}');
      background-repeat: no-repeat;
      background-size: cover;
    {% else %}
      background-color: {{ section.settings.back_color }};
    {% endif %}
  ">
  <div class="ctm-container"> 
    <div class="ctm-imgtxt {{ section.settings.pos_img }} {{ section.settings.design_op }} ">
        <div class="image-container" style="text-align:{{ section.settings.img_left }}; width:{{ section.settings.width_left }}%;">
         
           <div class="infoo-cr-{{ section.id }} {{ section.settings.pos_img2 }} card-slider dektop-{{ section.settings.columns_desktop }} mobile-cm-{{ section.settings.Mobile_Colmuns }}">
             {% if meta_images %}
             {% for image in meta_images %}
            <div class="Card-blocks">
               <div class="card">
                <img  class="lazyload" data-src="{{ image | img_url:'master' }}" class="desktop-v">
             </div> 
            </div>
           {%- endfor -%}
       
               {% else %}
               {% for block in section.blocks %}
               {% if block.settings.ctm_img12  %}
                    <img  class="lazyload" data-src="{{ block.settings.ctm_img12 | img_url: 'master' }}" alt="Custom Image" class="dektop-v">
                 {% endif %}
              {% if block.settings.ctm_img123  %}
                    <img  class="lazyload" data-src="{{ block.settings.ctm_img123 | img_url: 'master' }}" alt="Custom Image" class="mobile-v">
                 {% endif %}
                 {% endfor %}
             {% endif %}
        </div> 
        </div>
      {% assign title = product.metafields.custom.multiple_carousel_title.value %}
     
        <div class="text-container " style="width:{{ section.settings.width_right }}%; text-align:{{ section.settings.text_pos }}">
              {%- if section.settings.title_1 != blank and title != blank-%}
                  <h3 class="inline-richtext" style=" color: {{ section.settings.font_color }};">{{ section.settings.title_1 }}</h3>
          {% else %}
                <h3 class="inline-richtext" style=" color: {{ section.settings.font_color }};">Natural and certified organic Ingredients</h3>
                {%- endif -%}
              {%- if section.settings.text_1 != blank -%}
                <div class="rte" style=" color: {{ section.settings.font_color1 }};">{{ section.settings.text_1 }}</div>
                {%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a
                class="button button--primary"
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
              >
                {{ section.settings.button_label | escape }}
              </a>
            {%- endif -%}  </div>
    </div>
</div> 
  </div>
<style>
.show_section{
  display:block;
}
  .hide_section{
    display:none;
  }
    .card-slider {
	button {
		&.slick-prev {
			&.slick-arrow {
			    background: url('{{ 'arrow-left.svg' | asset_url }}');
				right: auto;
                width: 40px;
                height: 40px;
                background-repeat: no-repeat;
                background-size: contain;
                left: 7px;
			}
		}
		&.slick-next {
			&.slick-arrow {
			    background: url('{{ 'arrow-right.svg' | asset_url }}');
				width: 40px;
				height: 40px;
				background-repeat: no-repeat;
				background-size: contain;
              right: auto;
                left: 70px;
			}
		}
		&.slick-arrow {
			position: absolute;
			right: 0;
			top: auto;
			font-size: 0;
			background-color: transparent;
			border: unset;
            bottom: -68px;
		}
	}
}

  .ctm-imgtxt h3.inline-richtext {
    margin: 0 0 0px 0;
    font-size:{{ section.settings.font_size }}px;
    font-weight: 300;
    line-height: 46.2px;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
   
}
.ctm-imgtxt .rte p {
    font-size:{{ section.settings.font_size1 }}px;
    font-weight: 300;
    line-height: 26.6px;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
   
}
@media(max-width:767px) {
  
    .card-slider {
	button {
		&.slick-prev {
			&.slick-arrow {

                left: 21px;
			}
		}
		&.slick-next {
			&.slick-arrow {

                left: 90px;
			}
		}
	
	}
}
}
</style>


   <script>
     $('.infoo-cr-{{ section.id }}.Slider').slick({
        slidesToShow:{{ section.settings.block_slide }},
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        speed: 300,
        infinite: false,
        autoplaySpeed: 5000,
        autoplay: true,
        responsive: [
      {
        breakpoint: 991,
        settings: {
          slidesToShow:{{ section.settings.block_slide2 }},
        }
      },
      {
        breakpoint: 767,
        settings: {
          slidesToShow:{{ section.settings.block_slide3 }},
        }
      }
    ]
      });
    </script>

