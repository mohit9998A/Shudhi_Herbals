<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
<rect width="48" height="48" rx="24" fill="#A48E57" style="fill:#A48E57;fill:color(display-p3 0.6431 0.5569 0.3412);fill-opacity:1;"/>
<path d="M19 29L29 19M29 19H19M29 19V29" stroke="#FBFBFB" style="stroke:#FBFBFB;stroke:color(display-p3 0.9843 0.9843 0.9843);stroke-opacity:1;" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
                </a>
