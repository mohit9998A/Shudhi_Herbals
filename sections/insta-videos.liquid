{{ 'fresh-0-video-columns.css' | asset_url | stylesheet_tag }}

<div class="full-secton {{ section.settings.dynamic_class }} {{ section.settings.design }}"  style="padding-top:{{section.settings.pd_tp }}px; padding-bottom:{{section.settings.pd_bp }}px;
    {% if section.settings.back_img %}
      background-image: url('{{ section.settings.back_img | img_url: "master" }}');
      background-repeat: no-repeat;
      background-size: cover;
    {% else %}
    background-color:{{ section.settings.back_color }};
    {% endif %}">
    <div class="page-width container container-v2">
      <div class="slide-1 info">
        <div class="text-info"> 
       <h2 class="title inline-richtext" style="color:{{ section.settings.text_color }};   text-align:{{ section.settings.text_postion }};">
          {{ section.settings.title }}
        </h2>
           {%- if section.settings.text89 != blank -%}
      <div class="rte">{{ section.settings.text89 }}</div>
    {%- endif -%}
        </div>
        <div class="carosel">
          <div class="info-cr info-cr-{{ section.id }} {{ section.settings.pos_img }} dektop-{{ section.settings.columns_desktop }} mobile-cm-{{ section.settings.Mobile_Colmuns }}">
          
            <!----------------------------------- BLOCK CODE -----------------------------------------------> 
       
             {%- for block in section.blocks -%} 
              <div class="sl-content {{ section.settings.desogn }}">
                 <div class="box0-ctm" style="text-align: {{ section.settings.aligncenter }}; background: {{ section.settings.back_color1 }};">
                      <div class="image">
                           {% if block.settings.ctm_img  %}
                                <img src="{{ block.settings.ctm_img | img_url: 'master' }}" alt="Custom Image">
                           {% endif %}
                           {% if block.settings.ctm_video %}
                               <div class="video-container videoo-{{ section.id }}">
                                  <video id="video_{{ block.id }}"  class="custom-video ctm_video_{{ section.id }}" poster="{{ block.settings.poter_img | image_url: width: 300 }}">
                                      {% if block.settings.ctm_video.sources %}
                                          {% for source in block.settings.ctm_video.sources %}
                                              <source src="{{ source.url }}" type="{{ source.mime_type }}">
                                          {% endfor %}
                                      {% endif %}
                                    </video>
                                    <button class="play-button ply_btn_{{ section.id }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="62" height="62" viewBox="0 0 62 62" fill="none">
                                        <path d="M24.292 20.2067C24.292 19.4155 25.1672 18.9377 25.8327 19.3655L43.4002 30.6588C44.0125 31.0525 44.0125 31.9475 43.4002 32.3412L25.8328 43.6345C25.1672 44.0623 24.292 43.5845 24.292 42.7933V20.2067Z" stroke="#FBFBFB" style="stroke:#FBFBFB;stroke:color(display-p3 0.9843 0.9843 0.9843);stroke-opacity:1;" stroke-linecap="round" stroke-linejoin="round"/>
                                        <circle cx="31" cy="31" r="30.5" stroke="#FBFBFB" style="stroke:#FBFBFB;stroke:color(display-p3 0.9843 0.9843 0.9843);stroke-opacity:1;"/>
                                        </svg>
                                    </button>
                               </div>     
                          {% endif %}
                      </div>
                      <div class="text0">
                          {%- if block.settings.title != blank -%}
                              <h3 class="inline-richtext " style="font-size:{{ block.settings.heading_size12 }}px; color:{{ block.settings.colo898 }}; font-weight:{{ block.settings.font_weight }};">{{ block.settings.title }}</h3>
                          {%- endif -%}
                          {%- if block.settings.text != blank -%}
                            <div class="rte" style="font-size:{{ block.settings.heading_size1 }}px; color:{{ block.settings.colo89 }};">{{ block.settings.text }}</div>
                          {%- endif -%}
                          {%- if block.settings.link_label != blank -%}
                                <a class="link animate-arrow"
                                  {% if block.settings.link == blank %}
                                    role="link" aria-disabled="true"
                                  {% else %}
                                    href="{{ block.settings.link }}"
                                  {% endif %}
                                >
                                  {{- block.settings.link_label | escape -}}
                                  <span class="svg-wrapper"
