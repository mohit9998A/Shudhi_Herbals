</div>

<style>
  
.video-container {
    position: relative;
}
  .box0-ctm video {
    border-radius: 18px;
}
  .box0-ctm {
    padding: 10px;
    margin: {{ section.settings.mar_wh }}px;
}
  .box0-ctm {
    border-radius:{{ section.settings.radius }}px;;
}
  .carosel {
	button {
		&.slick-prev {
			&.slick-arrow {
			    background: url('{{ 'arrow-left.svg' | asset_url }}');
				right: 55px;
				width: 40px;
				height: 40px;
				background-repeat: no-repeat;
				background-size: contain;
			}
		}
		&.slick-next {
			&.slick-arrow {
			    background: url('{{ 'arrow-right.svg' | asset_url }}');
				width: 40px;
				height: 40px;
				background-repeat: no-repeat;
				background-size: contain;
			}
		}
		&.slick-arrow {
			position: absolute;
			right: 0;
			top: -50px;
			font-size: 0;
			background-color: transparent;
			border: unset;
		}
	}
}
  .box0-ctm {
    text-align: {{ section.settings.aligncenter}};
}
  .box0-ctm .image img {
    text-align:{{ section.settings.aligncenter}};
    margin: auto;
    margin-bottom: 30px;
  }
  .full-secton.Brand-logo .info-cr.grid .image img {
    width: 70%;
}
  .singal-btn .slide-1.info p {
    color: #B49C60;
}
   @media(max-width:767px) {
  .text-info h2 {
    font-size:{{ section.settings.heading_sizem }}px !important;
 }
  }
  @media(min-width:768px) {
    .text-info h2 {
    font-size:{{ section.settings.heading_size }}px !important;
    font-weight:500;
}
  }
  .video-playing button.play-button {
    opacity: 0;
}
  </style>
    <script>
     $('.info-cr-{{ section.id }}.Slider').slick({
        slidesToShow:{{ section.settings.block_slide }},
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        speed: 300,
        infinite: false,
        autoplaySpeed: 5000,
        autoplay: true,
        responsive: [
      {
        breakpoint: 991,
        settings: {
          slidesToShow:{{ section.settings.block_slide2 }},
        }
      },
      {
        breakpoint: 767,
        settings: {
          slidesToShow:{{ section.settings.block_slide3 }},
        }
      }
    ]
      });
    </script>
{% if section.settings.autplay_video == true %}
    <script>
document.addEventListener("DOMContentLoaded", function() {
    var videos = document.querySelectorAll('.vieww-in-all');

    // IntersectionObserver ko use kar rahe hain
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                // Jab video viewport mein aaye, autoplay shuru karo
                entry.target.play();
                entry.target.classList.add('visible');
            } else {
                
                entry.target.pause();
            }
        });
    }, { threshold: 0.5 }); 

    // Sabhi videos ko observer ke andar add karo
    videos.forEach(function(video) {
        observer.observe(video);
    });
});

    </script>
  {% else %}
<script>
document.addEventListener("DOMContentLoaded", function () {

  const videos = document.querySelectorAll('.ctm_video_{{ section.id }}');

  videos.forEach(function(video){

    const container = video.closest('.videoo-{{ section.id }}');

    container.addEventListener("click", function(){

      // Pause other videos and remove class
      videos.forEach(function(v){
        const c = v.closest('.videoo-{{ section.id }}');

        if(v !== video){
          v.pause();
          c.classList.remove("video-playing");
        }
      });

      // Toggle current video
      if(video.paused){
        video.play();
        container.classList.add("video-playing");
      }else{
        video.pause();
        container.classList.remove("video-playing");
      }

    });

  });

});

  </script>
  {% endif %}
