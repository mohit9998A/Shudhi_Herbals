<!-- /sections/page-track-order.liquid -->
<div class="hov-track-breadcrumb-container">
  {% include 'breadcrumb' %}
</div>

<section class="page-track-order hov-track-page-wrapper">
  <!-- Corner Leaves -->
  <!-- Bottom Left Large Leaf -->
  <svg class="hov-track-leaf hov-track-leaf-bl" viewBox="0 0 200 300" width="200" height="300" fill="none" stroke="#2D5A27" stroke-width="1.5" stroke-miterlimit="10" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 290 Q 80 200, 160 10" stroke-linecap="round" fill="none"/>
    <path d="M50 230 Q 10 180, 30 150 Q 70 190, 50 230 Z" fill="#2D5A27"/>
    <path d="M85 180 Q 130 140, 110 110 Q 75 140, 85 180 Z" fill="#2D5A27"/>
    <path d="M110 140 Q 80 80, 60 100 Q 85 130, 110 140 Z" fill="#2D5A27"/>
    <path d="M135 90 Q 180 50, 160 20 Q 125 50, 135 90 Z" fill="#2D5A27"/>
    <path d="M160 10 Q 140 -20, 120 0 Q 135 25, 160 10 Z" fill="#2D5A27"/>
  </svg>

  <!-- Top Right Large Leaf -->
  <svg class="hov-track-leaf hov-track-leaf-tr" viewBox="0 0 200 300" width="200" height="300" fill="none" stroke="#2D5A27" stroke-width="1.5" stroke-miterlimit="10" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 290 Q 80 200, 160 10" stroke-linecap="round" fill="none"/>
    <path d="M50 230 Q 10 180, 30 150 Q 70 190, 50 230 Z" fill="#2D5A27"/>
    <path d="M85 180 Q 130 140, 110 110 Q 75 140, 85 180 Z" fill="#2D5A27"/>
    <path d="M110 140 Q 80 80, 60 100 Q 85 130, 110 140 Z" fill="#2D5A27"/>
    <path d="M135 90 Q 180 50, 160 20 Q 125 50, 135 90 Z" fill="#2D5A27"/>
    <path d="M160 10 Q 140 -20, 120 0 Q 135 25, 160 10 Z" fill="#2D5A27"/>
  </svg>

  <!-- Top Left Small Leaf -->
  <svg class="hov-track-leaf hov-track-leaf-tl" viewBox="0 0 200 300" width="200" height="300" fill="none" stroke="#2D5A27" stroke-width="1.5" stroke-miterlimit="10" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 290 Q 80 200, 160 10" stroke-linecap="round" fill="none"/>
    <path d="M50 230 Q 10 180, 30 150 Q 70 190, 50 230 Z" fill="#2D5A27"/>
    <path d="M85 180 Q 130 140, 110 110 Q 75 140, 85 180 Z" fill="#2D5A27"/>
    <path d="M110 140 Q 80 80, 60 100 Q 85 130, 110 140 Z" fill="#2D5A27"/>
    <path d="M135 90 Q 180 50, 160 20 Q 125 50, 135 90 Z" fill="#2D5A27"/>
    <path d="M160 10 Q 140 -20, 120 0 Q 135 25, 160 10 Z" fill="#2D5A27"/>
  </svg>

  <!-- Bottom Right Small Leaf -->
  <svg class="hov-track-leaf hov-track-leaf-br" viewBox="0 0 200 300" width="200" height="300" fill="none" stroke="#2D5A27" stroke-width="1.5" stroke-miterlimit="10" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 290 Q 80 200, 160 10" stroke-linecap="round" fill="none"/>
    <path d="M50 230 Q 10 180, 30 150 Q 70 190, 50 230 Z" fill="#2D5A27"/>
    <path d="M85 180 Q 130 140, 110 110 Q 75 140, 85 180 Z" fill="#2D5A27"/>
    <path d="M110 140 Q 80 80, 60 100 Q 85 130, 110 140 Z" fill="#2D5A27"/>
    <path d="M135 90 Q 180 50, 160 20 Q 125 50, 135 90 Z" fill="#2D5A27"/>
    <path d="M160 10 Q 140 -20, 120 0 Q 135 25, 160 10 Z" fill="#2D5A27"/>
  </svg>

  <div class="hov-track-container">
    
    <!-- SECTION 1 — Page heading -->
    <div class="hov-track-header text-center">
      <h1 class="hov-track-title">Track Your Order</h1>
      <p class="hov-track-subtitle">Enter your order details to get real-time updates on your shipment</p>
    </div>

    <!-- SECTION 2 — Input card -->
    <div class="hov-track-card hov-track-input-card">
      <form id="hov-track-form" onsubmit="handleHovTrack(event)">
        <div class="hov-track-flex-row">
          <!-- Box Icon Column -->
          <div class="hov-track-icon-col">
            <div class="hov-track-box-circle">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#2D5A27" stroke-width="1.5">
                <path d="M21 8l-9-5-9 5v10l9 5 9-5V8z"/>
                <path d="M3 8l9 5 9-5"/>
                <path d="M12 13v10"/>
              </svg>
            </div>
          </div>
          
          <!-- Email or Phone Column -->
          <div class="hov-track-input-col">
            <label class="hov-track-label">Email or Phone Number</label>
            <div class="hov-track-input-wrapper">
              <span class="hov-track-input-svg">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </span>
              <input type="text" id="hov-track-contact" placeholder="enter your mobile number or mail id" required autocomplete="off">
            </div>
          </div>
        </div>
        
        <!-- Button Row -->
        <button type="submit" class="hov-track-btn-submit">
          Track Order
          <svg class="hov-track-btn-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <!-- Loading Spinner -->
      <div id="hov-track-loader" class="text-center py-4" style="display: none; margin-top: 15px;">
        <div class="hov-track-spinner"></div>
        <p class="mt-2 text-muted" style="font-size: 13px;">Retrieving shipment details...</p>
      </div>
    </div>

    <!-- ================= SECTION 3 — Order result card ================= -->
    
    <!-- DYNAMIC RESULTS CONTAINER (Filled and shown via JS guest lookup) -->
    <div id="hov-track-dynamic-result" class="hov-track-card hov-track-result-card" style="display: none;">
      <!-- Top Row -->
      <div class="hov-track-result-header">
        <div class="hov-track-result-meta">
          <h4 id="hov-res-order-id" class="hov-track-result-title">#ORD12345</h4>
          <span id="hov-res-date" class="hov-track-result-date">Placed on 24 May 2024</span>
        </div>
        <div class="hov-track-result-status">
          <span class="hov-track-status-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span id="hov-res-badge-text">In Transit</span>
          </span>
        </div>
      </div>

      <!-- Progress Stepper -->
      <div class="hov-track-stepper-container" id="hov-res-stepper" data-status="in-transit">
        <div class="hov-track-stepper-line-bg"></div>
        <div class="hov-track-stepper-line-active" id="hov-res-line-active"></div>
        
        <!-- Step 1: Placed -->
        <div class="hov-track-step" id="hov-res-step-1">
          <div class="hov-track-step-dot">
            <span class="hov-track-dot-completed">✓</span>
            <span class="hov-track-dot-active">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              </svg>
            </span>
            <span class="hov-track-dot-pending">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              </svg>
            </span>
          </div>
          <span class="hov-track-step-label">Order Placed</span>
          <span class="hov-track-step-time" id="hov-res-time-1">24 May, 10:30 AM</span>
        </div>

        <!-- Step 2: Shipped -->
        <div class="hov-track-step" id="hov-res-step-2">
          <div class="hov-track-step-dot">
            <span class="hov-track-dot-completed">✓</span>
            <span class="hov-track-dot-active">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 8l-9-5-9 5v10l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v10"/>
              </svg>
            </span>
            <span class="hov-track-dot-pending">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 8l-9-5-9 5v10l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v10"/>
              </svg>
            </span>
          </div>
          <span class="hov-track-step-label">Shipped</span>
          <span class="hov-track-step-time" id="hov-res-time-2">25 May, 02:15 PM</span>
        </div>

        <!-- Step 3: In Transit -->
        <div class="hov-track-step" id="hov-res-step-3">
          <div class="hov-track-step-dot">
            <span class="hov-track-dot-completed">✓</span>
            <span class="hov-track-dot-active">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </span>
            <span class="hov-track-dot-pending">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </span>
          </div>
          <span class="hov-track-step-label">In Transit</span>
          <span class="hov-track-step-time" id="hov-res-time-3">26 May, 08:45 AM</span>
        </div>

        <!-- Step 4: Delivered -->
        <div class="hov-track-step" id="hov-res-step-4">
          <div class="hov-track-step-dot">
            <span class="hov-track-dot-completed">✓</span>
            <span class="hov-track-dot-active">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </span>
            <span class="hov-track-dot-pending">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </span>
          </div>
          <span class="hov-track-step-label">Delivered</span>
          <span class="hov-track-step-time" id="hov-res-time-4">Expected by 28 May</span>
        </div>
      </div>

      <!-- Bottom Info Strip -->
      <div class="hov-track-info-strip">
        <div class="hov-track-info-col">
          <div class="hov-track-info-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="hov-track-info-text">
            <div class="hov-track-info-label">Delivery Address</div>
            <div class="hov-track-info-val">{{ section.settings.delivery_address }}</div>
          </div>
        </div>
        
        <div class="hov-track-info-divider"></div>
        
        <div class="hov-track-info-col">
          <div class="hov-track-info-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="hov-track-info-text">
            <div class="hov-track-info-label">Need Help?</div>
            <div class="hov-track-info-val">
              {{ section.settings.help_phone }}<br>
              {{ section.settings.help_email }}
            </div>
          </div>
        </div>
        
        <div class="hov-track-info-divider"></div>
        
        <div class="hov-track-info-col">
          <div class="hov-track-info-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="hov-track-info-text">
            <div class="hov-track-info-label">Delivery Time</div>
            <div class="hov-track-info-val">
              {{ section.settings.delivery_hours }}<br>
              {{ section.settings.delivery_days }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Shopify Real Order Check (renders if native order object exists) -->
    {% if order %}
      <div class="hov-track-card hov-track-result-card" style="display: block; margin-top: 24px;">
        {% liquid
          assign order_status = 'placed'
          assign line_width = '0%'
          assign step_1_class = 'completed'
          assign step_2_class = 'pending'
          assign step_3_class = 'pending'
          assign step_4_class = 'pending'

          if order.cancelled
            assign order_status = 'cancelled'
          elsif order.fulfillment_status == 'unfulfilled' or order.fulfillment_status == nil
            assign order_status = 'placed'
            assign step_1_class = 'active'
            assign line_width = '0%'
          elsif order.fulfillment_status == 'partial'
            assign order_status = 'shipped'
            assign step_1_class = 'completed'
            assign step_2_class = 'active'
            assign line_width = '33.33%'
          elsif order.fulfillment_status == 'fulfilled'
            assign order_status = 'in-transit'
            assign step_1_class = 'completed'
            assign step_2_class = 'completed'
            assign step_3_class = 'active'
            assign line_width = '66.66%'
          endif
        %}

        <!-- Top Row -->
        <div class="hov-track-result-header">
          <div class="hov-track-result-meta">
            <h4 class="hov-track-result-title">{{ order.name }}</h4>
            <span class="hov-track-result-date">Placed on {{ order.created_at | date: "%d %b %Y" }}</span>
          </div>
          <div class="hov-track-result-status">
            <span class="hov-track-status-badge">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              {{ order.fulfillment_status_label | default: 'In Transit' }}
            </span>
          </div>
        </div>

        <!-- Progress Stepper -->
        <div class="hov-track-stepper-container" data-status="{{ order_status }}">
          <div class="hov-track-stepper-line-bg"></div>
          <div class="hov-track-stepper-line-active" style="width: {{ line_width }};"></div>
          
          <!-- Step 1: Placed -->
          <div class="hov-track-step {{ step_1_class }}">
            <div class="hov-track-step-dot">
              <span class="hov-track-dot-completed">✓</span>
              <span class="hov-track-dot-active">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
              </span>
            </div>
            <span class="hov-track-step-label">Order Placed</span>
            <span class="hov-track-step-time">{{ order.created_at | date: "%d %b, %H:%M" }}</span>
          </div>

          <!-- Step 2: Shipped -->
          <div class="hov-track-step {{ step_2_class }}">
            <div class="hov-track-step-dot">
              <span class="hov-track-dot-completed">✓</span>
              <span class="hov-track-dot-active">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 8l-9-5-9 5v10l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v10"/>
                </svg>
              </span>
            </div>
            <span class="hov-track-step-label">Shipped</span>
            <span class="hov-track-step-time">{% if order.fulfillment_status != 'unfulfilled' %}{{ order.updated_at | date: "%d %b, %H:%M" }}{% else %}Pending{% endif %}</span>
          </div>

          <!-- Step 3: In Transit -->
          <div class="hov-track-step {{ step_3_class }}">
            <div class="hov-track-step-dot">
              <span class="hov-track-dot-completed">✓</span>
              <span class="hov-track-dot-active">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
            </div>
            <span class="hov-track-step-label">In Transit</span>
            <span class="hov-track-step-time">{% if order.fulfillment_status == 'fulfilled' %}{{ order.updated_at | date: "%d %b, %H:%M" }}{% else %}Pending{% endif %}</span>
          </div>

          <!-- Step 4: Delivered -->
          <div class="hov-track-step {{ step_4_class }}">
            <div class="hov-track-step-dot">
              <span class="hov-track-dot-completed">✓</span>
              <span class="hov-track-dot-pending">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </span>
            </div>
            <span class="hov-track-step-label">Delivered</span>
            <span class="hov-track-step-time">Expected in 3-5 days</span>
          </div>
        </div>

        <!-- Bottom Info Strip -->
        <div class="hov-track-info-strip">
          <div class="hov-track-info-col">
            <div class="hov-track-info-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="hov-track-info-text">
              <div class="hov-track-info-label">Delivery Address</div>
              <div class="hov-track-info-val">{{ section.settings.delivery_address }}</div>
            </div>
          </div>
          
          <div class="hov-track-info-divider"></div>
          
          <div class="hov-track-info-col">
            <div class="hov-track-info-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="hov-track-info-text">
              <div class="hov-track-info-label">Need Help?</div>
              <div class="hov-track-info-val">
                {{ section.settings.help_phone }}<br>
                {{ section.settings.help_email }}
              </div>
            </div>
          </div>
          
          <div class="hov-track-info-divider"></div>
          
          <div class="hov-track-info-col">
            <div class="hov-track-info-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#2D5A27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="hov-track-info-text">
              <div class="hov-track-info-label">Delivery Time</div>
              <div class="hov-track-info-val">
                {{ section.settings.delivery_hours }}<br>
                {{ section.settings.delivery_days }}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- PREVIEW ONLY / STATIC MOCK CARD -->
    {% unless order %}
      {% if request.path contains 'wishlist' or request.path contains 'track-order' or request.design_mode or request.params.view == 'track-order' %}
        <!-- preview only -->
        <div id="hov-track-preview-result" class="hov-track-card hov-track-result-card" style="display: block; margin-top: 24px;">
          <!-- Top Row -->
          <div class="hov-track-result-header">
            <div class="hov-track-result-meta">
              <h4 class="hov-track-result-title">#ORD12345</h4>
              <span class="hov-track-result-date">Placed on 24 May 2024</span>
            </div>
