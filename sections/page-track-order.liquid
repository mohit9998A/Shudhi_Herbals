<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
  function handleHovTrack(e) {
    e.preventDefault();
    
    var contact = document.getElementById('hov-track-contact').value.trim();
    if (!contact) return;
    
    // Hide static preview card and previous lookup result
    var previewCard = document.getElementById('hov-track-preview-result');
    if (previewCard) previewCard.style.display = 'none';
    
    var dynamicCard = document.getElementById('hov-track-dynamic-result');
    if (dynamicCard) dynamicCard.style.display = 'none';
    
    // Show spinner loader
    var loader = document.getElementById('hov-track-loader');
    if (loader) loader.style.display = 'block';
    
    // Generate deterministic values based on Contact hash
    var hash = 0;
    for (var i = 0; i < contact.length; i++) {
      hash += contact.charCodeAt(i);
    }
    
    // Generate a mock order number based on hash
    var mockOrderNum = "#ORD" + (10000 + (hash % 90000));
    
    // Determine status (1=placed, 2=shipped, 3=in-transit, 4=delivered)
    var step = (hash % 3) + 2; // Returns 2, 3, or 4
    if (contact.toLowerCase().indexOf('del') > -1) step = 4;
    if (contact.toLowerCase().indexOf('new') > -1) step = 1;
    
    var statusText = "In Transit";
    var statusAttr = "in-transit";
    if (step === 1) { statusText = "Order Placed"; statusAttr = "placed"; }
    else if (step === 2) { statusText = "Shipped"; statusAttr = "shipped"; }
    else if (step === 3) { statusText = "In Transit"; statusAttr = "in-transit"; }
    else if (step === 4) { statusText = "Delivered"; statusAttr = "delivered"; }
    
    // Calculate dates
    var options = { month: 'short', day: 'numeric', year: 'numeric' };
    var orderDate = new Date();
    orderDate.setDate(orderDate.getDate() - 3);
    var orderDateStr = orderDate.toLocaleDateString("en-US", options);
    
    var shipDate = new Date();
    shipDate.setDate(shipDate.getDate() - 2);
    var shipDateStr = shipDate.toLocaleDateString("en-US", options);
    
    var transitDate = new Date();
    transitDate.setDate(transitDate.getDate() - 1);
    var transitDateStr = transitDate.toLocaleDateString("en-US", options);
    
    var deliveryDate = new Date();
    deliveryDate.setDate(deliveryDate.getDate() + 2);
    var deliveryDateStr = deliveryDate.toLocaleDateString("en-US", options);
    
    setTimeout(function() {
      if (loader) loader.style.display = 'none';
      
      // Update dynamic card contents
      document.getElementById('hov-res-order-id').innerText = mockOrderNum;
      document.getElementById('hov-res-date').innerText = "Placed on " + orderDateStr;
      document.getElementById('hov-res-badge-text').innerText = statusText;
      
      // Update stepper data-status
      var stepper = document.getElementById('hov-res-stepper');
      stepper.setAttribute('data-status', statusAttr);
      
      // Update line position (mobile and desktop widths/heights)
      var activeLine = document.getElementById('hov-res-line-active');
      var widthVal = "0%";
      var heightVal = "0%";
      if (statusAttr === "shipped") { widthVal = "33.33%"; heightVal = "33.33%"; }
      else if (statusAttr === "in-transit") { widthVal = "66.66%"; heightVal = "66.66%"; }
      else if (statusAttr === "delivered") { widthVal = "100%"; heightVal = "100%"; }
      
      if (window.innerWidth <= 768) {
        activeLine.style.width = '2px';
        activeLine.style.height = heightVal;
      } else {
        activeLine.style.width = widthVal;
        activeLine.style.height = '2px';
      }
      
      // Update step status classes
      for (var s = 1; s <= 4; s++) {
        var stepNode = document.getElementById('hov-res-step-' + s);
        stepNode.className = "hov-track-step";
        if (s < step) {
          stepNode.classList.add('completed');
        } else if (s === step) {
          if (step === 4) {
            stepNode.classList.add('completed');
          } else {
            stepNode.classList.add('active');
          }
        } else {
          stepNode.classList.add('pending');
        }
      }
      
      // Update timestamps
      document.getElementById('hov-res-time-1').innerText = orderDateStr + ", 10:30 AM";
      document.getElementById('hov-res-time-2').innerText = shipDateStr + ", 02:15 PM";
      document.getElementById('hov-res-time-3').innerText = transitDateStr + ", 08:45 AM";
      if (step === 4) {
        document.getElementById('hov-res-time-4').innerText = "Delivered on " + transitDateStr;
      } else {
        document.getElementById('hov-res-time-4').innerText = "Expected by " + deliveryDateStr;
      }
      
      if (dynamicCard) dynamicCard.style.display = 'block';
    }, 1000);
  }
</script>

