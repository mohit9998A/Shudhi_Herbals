<style>
/* ── BODY LAYOUT ── */
.hov-wl__body {
  max-width: 1200px;
  margin: 48px auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 32px;
  align-items: start;
}

/* Override to single column when sidebar hidden */
.hov-wl__body:has(#hov-wl-sidebar[style*="display:none"]),
.hov-wl__body:has(#hov-wl-sidebar:not([style])) {
  grid-template-columns: 1fr;
}

/* Fallback for browsers without :has() */
.hov-wl__body--empty {
  grid-template-columns: 1fr !important;
}

/* ── HERO BANNER ── */
.hov-wl__hero {
  background: #FAF6EE;
  min-height: 0;
  height: 100px;           /* slim fixed height */
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid #EEE8DC;
  box-sizing: border-box;
}

.hov-wl__hero-left-deco {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 80px;   /* was 180px */
  height: 100%;
  display: flex;
  align-items: flex-end;
}
.hov-wl__hero-left-deco svg {
  width: 80px;
  height: auto;
  opacity: 0.5;
}

.hov-wl__hero-right-deco {
  position: absolute;
  right: 32px;
  bottom: 0;
  width: 70px;   /* was 160px */
  height: 100%;
  display: flex;
  align-items: flex-end;
}
.hov-wl__hero-right-deco svg {
  width: 70px;
  height: auto;
  opacity: 0.65;
}

.hov-wl__hero-title {
  font-size: 26px;    /* was clamp(32px,5vw,52px) */
  font-weight: 700;
  color: #1A2E1A;
  margin: 0 0 4px;
  line-height: 1.1;
  font-family: var(--font-heading, serif);
}
.hov-wl__hero-sub {
  font-size: 13px;    /* was 16px */
  color: #888;
  margin: 0 0 6px;
}
.hov-wl__breadcrumb {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  gap: 6px;
  color: #999;
}
.hov-wl__breadcrumb a {
  color: #666;
  text-decoration: none;
}
.hov-wl__breadcrumb a:hover { color: #2D5A27; }

.hov-wl__hero-text {
  text-align: center;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

/* Responsive */
@media (max-width: 768px) {
  .hov-wl__hero { height: 80px; }
  .hov-wl__hero-title { font-size: 20px; }
  .hov-wl__hero-sub { display: none; }
  .hov-wl__hero-left-deco,
  .hov-wl__hero-right-deco { display: none; }
}

@media (max-width: 480px) {
  .hov-wl__hero { height: 60px; }
  .hov-wl__hero-title { font-size: 18px; }
  .hov-wl__breadcrumb { display: none; }
}

/* ── TOOLBAR ── */
.hov-wl__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid #EEE;
}
.hov-wl__count {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}
.hov-wl__toolbar-actions { display: flex; gap: 12px; }
.hov-wl__toolbar-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #555;
  background: none;
  border: 1px solid #DDD;
  border-radius: 8px;
  padding: 8px 14px;
  cursor: pointer;
  transition: 0.2s ease;
}
.hov-wl__toolbar-btn:hover {
  border-color: #2D5A27;
  color: #2D5A27;
}
.hov-wl__toolbar-btn--danger:hover {
  border-color: #E53E3E;
  color: #E53E3E;
}

/* ── SKELETON LOADING ── */
.hov-wl__skel-item {
  height: 120px;
  background: linear-gradient(90deg,
    #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: hov-shimmer 1.4s infinite;
  border-radius: 16px;
  margin-bottom: 16px;
}
@keyframes hov-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── EMPTY STATE ── */
.hov-wl__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80px 24px 100px;
  width: 100%;
  min-height: 40vh;
  /* Critical: remove any left margin/grid offset */
  grid-column: 1 / -1; /* spans full grid width if inside .hov-wl__body grid */
  margin: 0 auto;
}
.hov-wl__empty svg {
  width: 64px;
  height: 64px;
  stroke: #DDD;
  stroke-width: 1.2;
  display: block;
  margin: 0 auto 20px;
}
.hov-wl__empty h3 {
  font-size: 22px;
  font-weight: 700;
  color: #1A2E1A;
  margin: 0 0 10px;
}
.hov-wl__empty p {
  font-size: 14px;
  color: #999;
  margin: 0;
  line-height: 1.6;
}
.hov-wl__empty-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #2D5A27;
  color: #FFF;
  border-radius: 999px;
  padding: 14px 32px;
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  margin-top: 24px;
  transition: 0.25s ease;
  white-space: nowrap;
}
.hov-wl__empty-cta:hover {
  background: #1A3D1A;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(45,90,39,0.25);
}
@media (max-width: 480px) {
  .hov-wl__empty-cta {
    width: calc(100% - 48px);
    justify-content: center;
    max-width: 280px;
  }
}

/* ── PRODUCT ITEMS ── */
.hov-wl__item {
  display: flex;
  align-items: center;
  gap: 20px;
  background: #FFFFFF;
  border: 1px solid #F0EBE0;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.hov-wl__item:hover {
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  transform: translateY(-2px);
}
@keyframes hov-wl-slide-in {
  from {
    opacity: 0;
    transform: translateY(-16px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
@keyframes hov-wl-fade-out {
  to {
    opacity: 0;
    transform: translateX(-20px);
    max-height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
  }
}

.hov-wl__item-img-wrap {
