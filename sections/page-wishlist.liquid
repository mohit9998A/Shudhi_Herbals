<script>
(function() {
  const cid = document.documentElement.dataset.customerId;
  const STORAGE_KEY = cid ? `hov_wishlist_${cid}` : 'hov_wishlist';

  function getIds() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
    catch { return []; }
  }
  function removeId(id) {
    const list = getIds().filter(i => i !== String(id));
    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
  }
  function clearAll() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify([]));
  }
  function formatMoney(cents) {
    return '₹' + Math.round(cents / 100).toLocaleString('en-IN');
  }

  // ── FETCH PRODUCTS ─────────────────────────────────────
  async function fetchProduct(id) {
    try {
      // Use Shopify Suggest API to find product by ID
      const res = await fetch(
        `/search/suggest.json?q=${id}&resources[type]=product&resources[limit]=1`
      );
      const data = await res.json();
      let found = data?.resources?.results?.products?.[0];
      
      // Fallback 1: search.json.liquid (using view=json)
      if (!found) {
        const fallbackRes = await fetch(`/search?view=json&q=id:${id}`);
        if (fallbackRes.ok) {
          const fallbackData = await fallbackRes.json();
          found = fallbackData?.[0];
        }
      }

      // Fallback 2: general search
      if (!found) {
        const fallbackRes2 = await fetch(`/search?view=json&q=${id}`);
        if (fallbackRes2.ok) {
          const fallbackData2 = await fallbackRes2.json();
          found = fallbackData2?.find(p => String(p.id) === String(id));
        }
      }

      if (!found || !found.handle) return null;

      // Fetch full product details
      const r2 = await fetch(`/products/${found.handle}.js`);
      return r2.ok ? r2.json() : null;
    } catch (e) {
      console.error('Error fetching product details for ID: ' + id, e);
      return null;
    }
  }

  // ── RENDER CARD ────────────────────────────────────────
  function renderProductItem(product) {
    const variant = product.variants?.[0];
    const price = variant?.price
      ? '₹' + (variant.price / 100).toFixed(0)
      : '₹' + product.price;
    const comparePrice = variant?.compare_at_price
      ? '₹' + (variant.compare_at_price / 100).toFixed(0) : '';
    const saving = variant?.compare_at_price && variant?.price
      ? Math.round((variant.compare_at_price - variant.price) / 100)
      : 0;
    const img = product.images?.[0] || product.featured_image || '';
    const tag = product.tags?.[0] || '';
    const descWords = (product.body_html || '')
      .replace(/<[^>]+>/g,'').split(' ').slice(0,8).join(' ');

    return `
      <div class="hov-wl__item" data-product-id="${product.id}"
           data-variant-id="${variant?.id || ''}">
        <div class="hov-wl__item-img-wrap">
          <img src="${img}" alt="${product.title}"
               class="hov-wl__item-img" loading="lazy"
               width="120" height="120">
        </div>
        <div class="hov-wl__item-info">
          <h3 class="hov-wl__item-title">
            <a href="/products/${product.handle}">${product.title}</a>
          </h3>
          ${descWords ? `<p class="hov-wl__item-desc">${descWords}…</p>` : ''}
          ${tag ? `<span class="hov-wl__item-tag">${tag}</span>` : ''}
          <div class="hov-wl__item-price">
            <span class="hov-wl__price">${price}</span>
            ${comparePrice
              ? `<span class="hov-wl__compare">${comparePrice}</span>` : ''}
            ${saving > 0
              ? `<span class="hov-wl__saved">Save ₹${saving}</span>` : ''}
          </div>
        </div>
        <div class="hov-wl__item-actions">
          <button class="hov-wl__item-remove"
                  data-product-id="${product.id}"
                  aria-label="Remove from wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6l-1 14H6L5 6"/>
              <path d="M10 11v6M14 11v6"/>
              <path d="M9 6V4h6v2"/>
            </svg>
          </button>
          <button class="hov-wl__item-atc"
                  data-variant-id="${variant?.id || ''}"
                  data-product-title="${product.title}">
            ADD TO BAG
          </button>
        </div>
      </div>`;
  }

  // ── SUMMARY ────────────────────────────────────────────
  function updateSummary(products) {
    let total = 0, saving = 0;
    products.forEach(p => {
      const v = p.variants?.[0];
      if (v?.price) total += v.price;
      if (v?.compare_at_price > v?.price)
        saving += v.compare_at_price - v.price;
    });
    const n = products.length;
    document.getElementById('hov-wl-count').textContent =
      `${n} Item${n !== 1 ? 's' : ''}`;
    document.getElementById('hov-wl-summary-count').textContent =
      `${n} Item${n !== 1 ? 's' : ''}`;
    document.getElementById('hov-wl-summary-total').textContent =
      formatMoney(total);
    document.getElementById('hov-wl-summary-saving').textContent =
      formatMoney(saving);
  }

  // ── ADD TO CART ────────────────────────────────────────
  async function addToCart(variantId, btn) {
    if (!variantId) return;
    btn.textContent = 'Adding…';
    btn.disabled = true;
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      });
      if (res.ok) {
        btn.textContent = '✓ Added!';
        btn.style.background = '#1E7A3E';
        
        // Trigger Shopify's AJAX cart drawer update
        if (window.ajaxCart && typeof window.ajaxCart.load === 'function') {
          window.ajaxCart.load();
        } else {
          document.dispatchEvent(new CustomEvent('cart:updated'));
        }
        
        setTimeout(() => {
          btn.textContent = 'ADD TO BAG';
          btn.style.background = '';
          btn.disabled = false;
        }, 2000);
      }
    } catch (e) {
      btn.textContent = 'ADD TO BAG';
      btn.disabled = false;
    }
  }

  // ── ADD ALL ─────────────────────────────────────────────
  async function addAllToCart() {
    const btns = document.querySelectorAll('.hov-wl__item-atc');
    for (const btn of btns) {
      await addToCart(btn.dataset.variantId, btn);
      await new Promise(r => setTimeout(r, 300));
    }
  }

  // ── REMOVE ITEM ─────────────────────────────────────────
  function removeItem(productId) {
    removeId(productId);
    const el = document.querySelector(
      `.hov-wl__item[data-product-id="${productId}"]`
    );
    if (el) {
      el.style.animation = 'hov-wl-fade-out 0.3s ease forwards';
      setTimeout(() => {
        el.remove();
        recount();
        recalcSummary?.();
      }, 320);
    }

    // sync ALL heart buttons with this product ID on the page
    window.hovSyncHeartButtons?.(productId, false);

    // dispatch event so other listeners update too
    document.dispatchEvent(new CustomEvent('hov:wishlist:changed', {
      detail: {
        productId: String(productId),
        added: false,
        list: getIds()
      }
    }));
    
    // Update global navbar count badge
    document.querySelectorAll('.hov-wish__nav-count').forEach(badge => {
      const n = getIds().length;
      badge.textContent = n > 99 ? '99+' : n;
      badge.style.display = n ? 'flex' : 'none';
    });
  }

  function recount() {
    const items = document.querySelectorAll('.hov-wl__item');
    const n = items.length;
    document.getElementById('hov-wl-count').textContent =
      `${n} Item${n !== 1 ? 's' : ''}`;
    if (n === 0) {
      document.getElementById('hov-wl-empty').style.display = 'flex';
      document.getElementById('hov-wl-toolbar').style.display = 'none';
      document.getElementById('hov-wl-sidebar').style.display = 'none';
      document.querySelector('.hov-wl__body')
        ?.classList.add('hov-wl__body--empty');
    } else {
      document.querySelector('.hov-wl__body')
        ?.classList.remove('hov-wl__body--empty');
    }
  }

  // ── MAIN RENDER ─────────────────────────────────────────
  async function renderWishlist() {
    const ids = getIds();
    const loading = document.getElementById('hov-wl-loading');
    const empty   = document.getElementById('hov-wl-empty');
    const itemsEl = document.getElementById('hov-wl-items');
    const toolbar = document.getElementById('hov-wl-toolbar');
    const sidebar = document.getElementById('hov-wl-sidebar');

    if (ids.length === 0) {
      loading.style.display = 'none';
      empty.style.display = 'flex';
      document.querySelector('.hov-wl__body')
        ?.classList.add('hov-wl__body--empty');
      return;
    }

    // Fetch all products in parallel
    const products = (await Promise.all(ids.map(fetchProduct)))
      .filter(Boolean);

    loading.style.display = 'none';

    if (products.length === 0) {
      empty.style.display = 'flex';
      document.querySelector('.hov-wl__body')
        ?.classList.add('hov-wl__body--empty');
      return;
    }

    // Render items
    itemsEl.innerHTML = products.map(p => renderProductItem(p)).join('');
    toolbar.style.display = 'flex';
    sidebar.style.display = 'block';
    document.querySelector('.hov-wl__body')
      ?.classList.remove('hov-wl__body--empty');
    updateSummary(products);

    // Wire events
    itemsEl.querySelectorAll('.hov-wl__item-remove').forEach(btn => {
      btn.addEventListener('click', () =>
        removeItem(btn.dataset.productId));
    });
    itemsEl.querySelectorAll('.hov-wl__item-atc').forEach(btn => {
      btn.addEventListener('click', () =>
        addToCart(btn.dataset.variantId, btn));
    });
    document.getElementById('hov-wl-add-all')
      ?.addEventListener('click', addAllToCart);
    document.getElementById('hov-wl-move-all')
      ?.addEventListener('click', addAllToCart);
    document.getElementById('hov-wl-clear')
      ?.addEventListener('click', () => {
        clearAll();
        itemsEl.innerHTML = '';
        toolbar.style.display = 'none';
        sidebar.style.display = 'none';
        empty.style.display = 'flex';
        document.querySelector('.hov-wl__body')
          ?.classList.add('hov-wl__body--empty');
        
        // Update global navbar count badge
        document.querySelectorAll('.hov-wish__nav-count').forEach(badge => {
          badge.style.display = 'none';
        });
      });
  }

  document.addEventListener('DOMContentLoaded', renderWishlist);

  // ── Only run on wishlist page ──
  if (window.location.pathname.includes('/pages/wishlist')) {

    // ── HANDLER: re-render or patch DOM instantly ──
    async function handleWishlistChange(detail) {
      const { productId, added, product, list } = detail;
      const itemsEl = document.getElementById('hov-wl-items');
      const emptyEl  = document.getElementById('hov-wl-empty');
      const toolbar  = document.getElementById('hov-wl-toolbar');
      const sidebar  = document.getElementById('hov-wl-sidebar');
      const body     = document.querySelector('.hov-wl__body');

      if (added) {
        // ── ADD: fetch product and prepend to list ──
        emptyEl.style.display = 'none';
        toolbar.style.display = 'flex';
        sidebar.style.display = 'block';
        body?.classList.remove('hov-wl__body--empty');

        // Show skeleton placeholder immediately
        const placeholder = document.createElement('div');
        placeholder.className = 'hov-wl__skel-item';
        placeholder.id = `hov-wl-skel-${productId}`;
        itemsEl.prepend(placeholder);

        // Fetch full product data
        let fullProduct = null;
        try {
          if (product?.handle) {
            const r = await fetch(`/products/${product.handle}.js`);
            if (r.ok) fullProduct = await r.json();
          }
          if (!fullProduct) {
            // Fallback: search by ID
            const r2 = await fetch(
              `/search/suggest.json?q=${productId}` +
              `&resources[type]=product&resources[limit]=1`
            );
            const d = await r2.json();
            const found = d?.resources?.results?.products?.[0];
            if (found) {
              const r3 = await fetch(`/products/${found.handle}.js`);
              if (r3.ok) fullProduct = await r3.json();
            }
          }
        } catch(e) {}

        // Replace skeleton with real card
        placeholder.remove();
        if (fullProduct) {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = renderProductItem(fullProduct);
          const newItem = tempDiv.firstElementChild;
          newItem.style.animation = 'hov-wl-slide-in 0.4s ease forwards';
          itemsEl.prepend(newItem);

          // Wire events on new item
          newItem.querySelector('.hov-wl__item-remove')
            ?.addEventListener('click', () =>
              removeItem(fullProduct.id));
          newItem.querySelector('.hov-wl__item-atc')
            ?.addEventListener('click', function() {
              addToCart(this.dataset.variantId, this);
            });
        }

      } else {
        // ── REMOVE: animate out and remove from DOM ──
        const existingItem = document.querySelector(
          `.hov-wl__item[data-product-id="${productId}"]`
        );
        if (existingItem) {
          existingItem.style.animation =
            'hov-wl-fade-out 0.35s ease forwards';
          setTimeout(() => {
            existingItem.remove();
            recount();
            recalcSummary();
          }, 380);
        }
      }

      // Always update counts and summary
      setTimeout(recalcSummary, 400);
      updateNavCount();
    }

    // ── Recalculate summary from current DOM ──
    function recalcSummary() {
      const items = document.querySelectorAll('.hov-wl__item');
      const n = items.length;
      document.getElementById('hov-wl-count').textContent =
        `${n} Item${n !== 1 ? 's' : ''}`;
      document.getElementById('hov-wl-summary-count').textContent =
        `${n} Item${n !== 1 ? 's' : ''}`;

      // Recalculate totals from price elements
      let total = 0, saving = 0;
      items.forEach(item => {
        const priceEl = item.querySelector('.hov-wl__price');
        const compareEl = item.querySelector('.hov-wl__compare');
        if (priceEl) {
          const p = parseInt(
            priceEl.textContent.replace(/[^0-9]/g, '')
          );
          if (!isNaN(p)) total += p;
        }
        if (compareEl) {
          const c = parseInt(
            compareEl.textContent.replace(/[^0-9]/g, '')
          );
          const pr = parseInt(
            item.querySelector('.hov-wl__price')
              ?.textContent.replace(/[^0-9]/g, '') || '0'
          );
          if (!isNaN(c) && !isNaN(pr) && c > pr)
            saving += c - pr;
        }
      });
      document.getElementById('hov-wl-summary-total').textContent =
        '₹' + total.toLocaleString('en-IN');
      document.getElementById('hov-wl-summary-saving').textContent =
        '₹' + saving.toLocaleString('en-IN');

      if (n === 0) {
        document.getElementById('hov-wl-empty').style.display = 'flex';
        document.getElementById('hov-wl-toolbar').style.display = 'none';
        document.getElementById('hov-wl-sidebar').style.display = 'none';
        document.querySelector('.hov-wl__body')
          ?.classList.add('hov-wl__body--empty');
      }
    }

    // ── LISTENER 1: Same-page CustomEvent ──
    document.addEventListener('hov:wishlist:changed', (e) => {
      handleWishlistChange(e.detail);
    });

    // ── LISTENER 2: BroadcastChannel (other tabs) ──
    try {
      const bc = new BroadcastChannel('hov_wishlist_channel');
      bc.onmessage = (e) => {
        if (e.data?.type === 'wishlist:changed') {
          handleWishlistChange(e.data);
        }
      };
    } catch(e) {}

    // ── LISTENER 3: localStorage storage event (other tabs fallback) ──
    window.addEventListener('storage', (e) => {
      if (e.key !== STORAGE_KEY) return;
      const oldList = e.oldValue
        ? JSON.parse(e.oldValue) : [];
      const newList = e.newValue
        ? JSON.parse(e.newValue) : [];

      // Find what changed
      const added = newList.filter(id => !oldList.includes(id));
      const removed = oldList.filter(id => !newList.includes(id));

      added.forEach(id => handleWishlistChange({
        productId: id, added: true, list: newList
      }));
      removed.forEach(id => handleWishlistChange({
        productId: id, added: false, list: newList
      }));
    });

    // Sync all heart buttons on page to match localStorage state
    function syncAllHeartStates() {
      const list = getIds();
      document.querySelectorAll('.hov-wish__btn').forEach(btn => {
        const id = String(btn.dataset.productId || '');
        if (!id) return;
        window.hovSyncHeartButtons?.(id, list.includes(id));
      });
    }

    // Call after DOM is ready and after recommendations load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(syncAllHeartStates, 800); // wait for recommendation grid to render
      });
    } else {
      setTimeout(syncAllHeartStates, 800);
    }

    // Also call whenever wishlist changes
    document.addEventListener('hov:wishlist:changed', () => {
      setTimeout(syncAllHeartStates, 100);
    });

    // Hook recommendation grid hearts via MutationObserver
    if (window.MutationObserver) {
      let syncTimer = null;
      new MutationObserver((mutations) => {
        const hasNewButtons = mutations.some(m =>
          [...m.addedNodes].some(n =>
            n.nodeType === 1 && (
              n.classList?.contains('hov-wish__btn') ||
              n.querySelector?.('.hov-wish__btn')
            )
          )
        );
        if (hasNewButtons) {
          clearTimeout(syncTimer);
          syncTimer = setTimeout(syncAllHeartStates, 150);
        }
      }).observe(document.body, { childList: true, subtree: true });
    }

    // Tab category buttons in recommendation grid re-sync
    document.querySelectorAll(
      '.hov-wl__rec-tab, [class*="rec-tab"], [data-category-tab]'
    ).forEach(tab => {
      tab.addEventListener('click', () => {
        setTimeout(syncAllHeartStates, 300);
      });
    });
  }
})();
</script>

