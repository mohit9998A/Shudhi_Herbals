{{ 'fresh-0-images-slider.css' | asset_url | stylesheet_tag }}
{% assign whats_make_of_house_of_veda_desktop = product.metafields.custom.whats_make_of_house_of_veda_desktop %}
{% assign whats_make_of_house_of_veda_mobile = product.metafields.custom.whats_make_of_house_of_veda_mobile %}

{% assign boost_your_health_with_certified_mobile = product.metafields.custom.boost_your_health_with_certified_mobile %}
{% assign boost_your_health_with_certified_desktop = product.metafields.custom.boost_your_health_with_certified_desktop %}

{% if whats_make_of_house_of_veda_desktop and whats_make_of_house_of_veda_mobile or boost_your_health_with_certified_desktop and boost_your_health_with_certified_mobile %}
<div class="image-slider {{ section.settings.design }}" style="
    {% if section.settings.back_img %}
      background-image: url('{{ section.settings.back_img | img_url: "master" }}');
      background-repeat: no-repeat;
      background-size: cover;
    {% else %}
      background-color: {{ section.settings.back_color }};
    {% endif %}
  ">
   <div class="page-width container  block-slide-{{ section.settings.pos_img12 }} ctmm_slide-{{ section.id }}">
     <div class="let67">
          <div class="text-info"> 
          <h2 class="title inline-richtext">
          <span style="font-size:{{ section.settings.heading_sizem2 }}px;">{{ section.settings.subtitle }}</span>
          {{ section.settings.title }}
        </h2>
        </div>
     </div>
      <div class="card-sl-list desktop small-hide ">
           {%- for block in section.blocks -%} 
                {% case block.type %}
                  {%- when 'desktop-slider' -%}  
         <div class="desktop-slider card-box"> 
           <div class="card-sl">
         {% if block.settings.ctm_img1  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img1 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img2  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img2 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img3  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img3 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img4  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img4 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
 
        </div>
         </div>
                  
                    {%- endcase -%}
             {%- endfor -%}
             
      </div>
  {%- for block in section.blocks -%} 
                {% case block.type %}
      {%- when 'mobile-slide' -%}  
                  <div class="mobile-slider">
         <div class="card-sl-ml">
         {% if block.settings.ctm_img17  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img17 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img27  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img27 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img37  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img37 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img47  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img47 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img5  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img5 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img6  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img6 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img7  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img7 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img8  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img8 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img9  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img9 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img10  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img10 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img11  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img11 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
         {% if block.settings.ctm_img12  %}<div class="card-sl-img"> <img  class="lazyload" data-src="{{ block.settings.ctm_img12 | img_url: 'master' }}" alt="Custom Image"></div>{% endif %}
                   </div> </div>
                   {%- endcase -%}
             {%- endfor -%}
   </div>
  
</div>
{% endif %}
<style>

   .card-sl-list {
	button {
		&.slick-prev {
			&.slick-arrow {
			    background: url('{{ 'arrow-left.svg' | asset_url }}');
				right: 55px;
				width: 40px;
				height: 40px;
				background-repeat: no-repeat;
				background-size: contain;
			}
		}
		&.slick-next {
			&.slick-arrow {
			    background: url('{{ 'arrow-right.svg' | asset_url }}');
				width: 40px;
				height: 40px;
				background-repeat: no-repeat;
				background-size: contain;
			}
		}
		&.slick-arrow {
			position: absolute;
			right: 0;
			top: -56px;
			font-size: 0;
			background-color: transparent;
			border: unset;
		}
	}
}
     .image-slider .text-info h2 span{
       font-size:{{ section.settings.heading_sizem2 }}px;
     }
 
    @media(max-width:767px) {
   .image-slider .text-info h2 {
    font-size:{{ section.settings.heading_sizem }}px;
    color:{{ section.settings.text_color }};
    text-align:{{ section.settings.text_postion }};
 }
      .mobile-slider button.slick-next.slick-arrow {
    right: 34%;
}
.mobile-slider button.slick-prev.slick-arrow {
    left: 37%;
} 
  
.mobile-slider button.slick-arrow:before {
    content: unset;
}
.mobile-slider button.slick-arrow {
    border: unset;
}
.mobile-slider button.slick-arrow {
    border: unset;
    bottom: -80px;
    top: auto;
}
.mobile-slider button.slick-prev.slick-arrow {
    background: url('https://cdn.shopify.com/s/files/1/0583/0760/8679/files/Component_23_786aad0c-1ac5-4fa3-9f41-a0b66660ebc7.svg?v=1737965143');
    right: 55px;
    width: 40px;
    height: 40px;
    background-repeat: no-repeat;
    background-size: contain;
}
.mobile-slider button.slick-next.slick-arrow {
    background: url('https://cdn.shopify.com/s/files/1/0583/0760/8679/files/Component_22.svg?v=1737965671');
    width: 40px;
    height: 40px;
    background-repeat: no-repeat;
    background-size: contain;
}
      .image-slider {
    padding-top: 29px !important;
}
  }
  @media(min-width:768px) {
    .image-slider .text-info h2 {
    font-size:{{ section.settings.heading_size }}px;
    color:{{ section.settings.text_color }};
    text-align:{{ section.settings.text_postion }};
}
    .mobile-slider {
    display: none;
}
  }
   .image-slider {
    padding-top:{{section.settings.pd_tp }}px;
    padding-bottom:{{section.settings.pd_bp }}px;
    background:{{section.settings.back_color }};
}
    
   .mobile-slider img {
    width: 100%;
}
  .block-slide-Grid .card-sl .card-sl-img {
    width: 100%;
}
</style>

  <script>
     $('.block-slide-Slider.ctmm_slide-{{ section.id }} .card-sl-list, .block-slide-Slider.ctmm_slide-{{ section.id }} .mobile-slider .card-sl-ml').slick({
        slidesToShow:1,
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        speed: 300,
        infinite: true,
        autoplaySpeed: 5000,
        autoplay: true,
      });
  </script>
  
  
