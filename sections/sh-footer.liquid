{%- comment -%}
  SHUDHI — Footer

  Rendered statically from layout/theme.liquid (homepage only), so Shopify
  IGNORES the `presets` block. Link columns are seeded in
  config/settings_data.json; the no-blocks fallback below covers a merchant
  who deletes them all.

  Each column can take either a Shopify menu (preferred) or a plain
  "Label | /url" list, one per line.
{%- endcomment -%}

{%- assign s = section.settings -%}

<footer class="sh sh-footer" style="--sh-green-900:{{ s.bg }};" role="contentinfo">
  <div class="sh-wrap">
    <div class="sh-footer__grid">

      {%- comment -%} Newsletter {%- endcomment -%}
      <div class="sh-footer__news">
        {%- if s.news_title != blank -%}<div class="sh-footer__title">{{ s.news_title }}</div>{%- endif -%}
        {%- if s.news_body != blank -%}<p class="sh-footer__text">{{ s.news_body }}</p>{%- endif -%}

        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="sh-news">
            <label class="sh-visually-hidden" for="sh-news-email">Email address</label>
            <input id="sh-news-email" type="email" name="contact[email]"
                   placeholder="{{ s.news_placeholder }}" required autocomplete="email">
            <button type="submit" aria-label="Subscribe">
              {% render 'sh-icon', name: 'arrow-right' %}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="sh-footer__text" style="margin-top:12px;">{{ s.news_success }}</p>
          {%- endif -%}
        {%- endform -%}

        {%- if s.instagram != blank or s.facebook != blank or s.pinterest != blank or s.youtube != blank or s.email != blank -%}
          <div class="sh-social">
            {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'sh-icon', name: 'instagram' %}</a>{%- endif -%}
            {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'sh-icon', name: 'facebook' %}</a>{%- endif -%}
            {%- if s.pinterest != blank -%}<a href="{{ s.pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'sh-icon', name: 'pinterest' %}</a>{%- endif -%}
            {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'sh-icon', name: 'youtube' %}</a>{%- endif -%}
            {%- if s.email != blank -%}<a href="mailto:{{ s.email }}" aria-label="Email us">{% render 'sh-icon', name: 'mail' %}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Centre brand lockup.

          Renders the SAME shudhi-logo-light.png the header does, so the two can
          never drift apart — the inline `shudhi-mark` SVG that used to sit here
          is a stylised approximation of the artwork, not the artwork itself.
          Mirrors the header's use_asset_logo switch, so the text lockup remains
          a one-click fallback rather than being deleted outright.

          loading="lazy", unlike the header's eager copy: this is always below
          the fold, and it is the same asset URL, so on the pages that render
          both it is already in cache and costs no second request.
      {%- endcomment -%}
      <div class="sh-footer__brand">
        <span class="sh-logo">
          {%- if s.use_asset_logo -%}
            <img class="sh-logo__img" src="{{ 'shudhi-logo-light.png' | asset_url }}"
                 alt="{{ shop.name | escape }}" width="562" height="400"
                 loading="lazy" decoding="async">
          {%- else -%}
            {% render 'sh-icon', name: 'shudhi-mark', class: 'sh-logo__mark' %}
            <span class="sh-logo__text">
              <b>{{ s.brand_name }}</b>
              <small>{{ s.brand_sub }}</small>
            </span>
          {%- endif -%}
        </span>
        {%- if s.tagline != blank -%}<p class="sh-footer__tagline">{{ s.tagline }}</p>{%- endif -%}
        {%- if s.copyright != blank -%}<p class="sh-footer__copy">{{ s.copyright }}</p>{%- endif -%}
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="sh-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <div class="sh-footer__title">{{ block.settings.heading }}</div>
            {%- endif -%}
            <div class="sh-footer__links">
              {%- assign menu = linklists[block.settings.menu] -%}
              {%- if menu != blank and menu.links.size > 0 -%}
                {%- for link in menu.links -%}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {%- endfor -%}
              {%- elsif block.settings.links != blank -%}
                {%- assign rows = block.settings.links | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign row = row | strip -%}
                  {%- if row != blank -%}
                    {%- assign parts = row | split: '|' -%}
                    {%- assign label = parts[0] | strip -%}
                    {%- assign href = parts[1] | strip | default: '#' -%}
                    <a href="{{ href }}">{{ label }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="sh-footer__col">
          <div class="sh-footer__title">Quick Links</div>
          <div class="sh-footer__links">
            <a href="{{ routes.root_url }}">Home</a>
            <a href="/products/negativity-removal-cleansing-bar">Shop</a>
            <a href="/pages/our-story">Our Story</a>
            <a href="/pages/the-ritual">The Ritual</a>
            <a href="{{ blog.url | default: '/blogs/news' }}">Journal</a>
          </div>
        </div>

        {%- comment -%} All five written policies, in the order Shopify admin
            lists them. shop.policies would self-maintain, but the seeded
            blocks in settings_data.json are plain link lists, so this mirrors
            them literally — the two must read the same. {%- endcomment -%}
        <div class="sh-footer__col">
          <div class="sh-footer__title">Service &amp; Support</div>
          <div class="sh-footer__links">
            <a href="/policies/shipping-policy">Shipping Policy</a>
            <a href="/policies/refund-policy">Refund Policy</a>
            <a href="/policies/privacy-policy">Privacy Policy</a>
            <a href="/policies/terms-of-service">Terms of Service</a>
            <a href="/policies/contact-information">Contact Information</a>
          </div>
        </div>

        {%- comment -%} FAQs points at the homepage band (#faq), the only FAQ
            content that resolves today: /pages/faqs is a 404 until the Page
            resource is created in admin, even though page.faqs.json exists.
        {%- endcomment -%}
        <div class="sh-footer__col">
          <div class="sh-footer__title">Contact Us</div>
          <div class="sh-footer__links">
            <a href="/pages/contact">Contact Us</a>
            <a href="{{ routes.root_url }}#faq">FAQs</a>
            <a href="mailto:help@shudhiherbals.com">help@shudhiherbals.com</a>
          </div>
        </div>
      {%- endif -%}

    </div>

    {%- if s.bottom_note != blank -%}
      <div class="sh-footer__bottom">{{ s.bottom_note }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Not rendered on the home page. The footer section is shared,
      so this is scoped by template rather than removed outright — inner pages
      keep the control. Both JS users are null-guarded (`if (top)` in sync(),
      `if (!btn) return` in toTop()), so its absence needs no script change.
  {%- endcomment -%}
  {%- unless template.name == 'index' -%}
    <button type="button" class="sh-totop" data-to-top aria-label="Back to top">
      {% render 'sh-icon', name: 'arrow-up' %}
    </button>
  {%- endunless -%}
</footer>

{% schema %}
{
  "name": "SH · Footer",
  "class": "sh-footer-section",
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "news_title", "label": "Heading", "default": "Join our wellness circle" },
    { "type": "textarea", "id": "news_body", "label": "Body", "default": "Be the first to know about new rituals, offers & herbal wisdom." },
    { "type": "text", "id": "news_placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "news_success", "label": "Success message", "default": "Thanks for subscribing." },

    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "text", "id": "email", "label": "Email address",
      "info": "Renders a mail icon linking to this address." },

    { "type": "header", "content": "Brand" },
    { "type": "checkbox", "id": "use_asset_logo", "label": "Use the logo image", "default": true,
      "info": "Renders shudhi-logo-light.png from Assets — the same logo as the header. Uncheck to fall back to the text lockup below." },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "SHUDHI",
      "info": "Text lockup only — unused while \"Use the logo image\" is on." },
    { "type": "text", "id": "brand_sub", "label": "Brand sub-line", "default": "HERBALS",
      "info": "Text lockup only — unused while \"Use the logo image\" is on." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Purify your presence." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 Shudhi Herbals. All rights reserved." },
    { "type": "text", "id": "bottom_note", "label": "Bottom bar note", "default": "Made with intention · Rooted in Ayurveda" },

    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1b2411" }
  ],
  "blocks": [
    { "type": "column", "name": "Link column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Links" },
      { "type": "link_list", "id": "menu", "label": "Menu", "info": "Takes priority over the manual list below." },
      { "type": "textarea", "id": "links", "label": "Manual links", "info": "One per line, as: Label | /url" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "SH · Footer", "blocks": [
    { "type": "column", "settings": { "heading": "Quick Links",        "links": "Home | /\nShop | /products/negativity-removal-cleansing-bar\nOur Story | /pages/our-story\nThe Ritual | /pages/the-ritual\nJournal | /blogs/news" } },
    { "type": "column", "settings": { "heading": "Service & Support",  "links": "Shipping Policy | /policies/shipping-policy\nRefund Policy | /policies/refund-policy\nPrivacy Policy | /policies/privacy-policy\nTerms of Service | /policies/terms-of-service\nContact Information | /policies/contact-information" } },
    { "type": "column", "settings": { "heading": "Contact Us",         "links": "Contact Us | /pages/contact\nFAQs | /#faq\nhelp@shudhiherbals.com | mailto:help@shudhiherbals.com" } }
  ] } ]
}
{% endschema %}
