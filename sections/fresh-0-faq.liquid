          "label": "Text"
        },
        
           {
        "type": "range",
        "id": "heading_size11",
        "label": "Font Size",
        "default":12,
        "min": 10,
        "max": 20,
        "step": 1
      },
        {
      "type": "color",
      "id": "colo891",
      "label": "Text colo",
      "default": "#000"
       },
       {
          "type": "text",
          "id": "link_label",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
       {
        "type": "range",
        "id": "heading_size12",
        "label": "Accordion question Font Size",
        "default":12,
        "min": 10,
        "max": 20,
        "step": 1
       },
       {
      "type": "color",
      "id": "colo898",
      "label": "Accordion question Text color",
      "default": "#000"
       },
          {
        "type": "range",
        "id": "heading_size1",
        "label": "Accordion Answer Font Size",
        "default":12,
        "min": 10,
        "max": 20,
        "step": 1
      },
       {
      "type": "color",
      "id": "colo89",
      "label": "Accordion Answer Text color",
      "default": "#000"
       }
    ],
        "blocks": [
    {
      "type": "tab",
      "name": "tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "ctm_img",
          "label": "Image"
        },
         {
          "type": "inline_richtext",
          "id": "title",
          "default": "colmun",
          "label": "Tittle"
        },
           {
        "type": "range",
        "id": "heading_size12",
        "label": "Font Size",
        "default":12,
        "min": 10,
        "max": 20,
        "step": 1
       },
      {
      "type": "color",
      "id": "colo898",
      "label": "Text colo",
      "default": "#000"
       },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Personal care Organic Amla Ginger Green Tea. Our herbal tea boosts immunity, </p>",
          "label": "Text"
        },
        
           {
        "type": "range",
        "id": "heading_size1",
        "label": "Font Size",
        "default":12,
        "min": 10,
        "max": 20,
        "step": 1
      },
        {
      "type": "color",
      "id": "colo89",
      "label": "Text colo",
      "default": "#000"
       }
      ]
    }
  ],
       "presets": [
    {
      "name": "fresh-0-faq",
    }
  ]
  }
{% endschema %}