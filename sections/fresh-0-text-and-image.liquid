{{ 'fresh-0-text-and-image.css' | asset_url | stylesheet_tag }}
{% assign show_message = true %}

{% if template contains 'product' and product.metafields.custom.fresh_text_title_ == blank or 
 product.metafields.custom.fresh_text_image_ == blank %}
  {% assign show_message = false %}
{% endif %}

{% if show_message %}
<div class="img-text {{ section.settings.class_name }}"  style=" padding-top:{{section.settings.pd_tp }}px; padding-bottom:{{section.settings.pd_bp }}px;
    {% if section.settings.back_img %}
      background-image: url('{{ section.settings.back_img | img_url: "master" }}');
      background-repeat: no-repeat;
      background-size: cover;
    {% else %}
      background-color: {{ section.settings.back_color }};
    {% endif %}
  "> 
   {% if section.settings.back_img23 %}<div class="top-image"><img src="{{ section.settings.back_img23 | img_url: "master" }}"></div>{% endif %}
  <div class="page-width container "> 
        <div class="section-tittle">
             {%- if section.settings.story67 != blank -%}
              <h1 class="heading">{{ section.settings.story67 }}</h1>
                {%- endif -%}
   {%- if section.settings.story6 != blank -%}
                  <span class="inline-richtext">{{ section.settings.story6 }}</span> 
                {%- endif -%}
          </div>
    <div class="ctm-imgtxt {{ section.settings.pos_img }} {{ section.settings.design_op }} ">
        <div class="image-container" style="text-align:{{ section.settings.img_left }}; width:{{ section.settings.width_left }}%;">
          {% if section.settings.ctm_img  %}
                <img  class="lazyload" data-src="{{ section.settings.ctm_img | img_url: 'master' }}" alt="{{ section.settings.ctm_img.alt }}">
             {% endif %}
            {% if section.settings.ctm_video %}
                  <video class="ctm-custom-video-{{ section.id }}" poster="{{ section.settings.poter_img | img_url: 'master' }}" >
                      {% if section.settings.ctm_video.sources %}
                        {% for source in section.settings.ctm_video.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      {% endif %}
                    </video>
            {% endif %}
        </div>
        <div class="text-container " id="{%- if section.settings.icon_show -%} ctm-icon{%- endif -%}" style="width:{{ section.settings.width_right }}%; text-align:{{ section.settings.text_pos }}">
          <div class="info-text  section-{{ section.id }}">
          {% if section.settings.ctm_img12  %}
                <img  class="lazyload" data-src="{{ section.settings.ctm_img12 | img_url: 'master' }}" alt="Custom Image" class="dektop-v">
             {% endif %}
          {% if section.settings.ctm_img123  %}
                <img  class="lazyload" data-src="{{ section.settings.ctm_img123 | img_url: 'master' }}" alt="Custom Image" class="mobile-v">
             {% endif %}
          
             {%- if section.settings.sub_color12 != blank -%}
                  <span class="sub-heading" style="color: {{ section.settings.sub_color }};">{{ section.settings.sub_color12 }}</span>
                {%- endif -%}
              {%- if section.settings.title_1 != blank -%}
                  <h3 class="inline-richtext" style="color: {{ section.settings.font_color }};padding-bottom:22px;">{{ section.settings.title_1 }}</h3>
                {%- endif -%}
              {%- if section.settings.text_1 != blank -%}
                <div class="rte" style="color: {{ section.settings.font_color1 }};">{{ section.settings.text_1 }}</div>
                {%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a
                class="button button--primary ctm-btn"
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
              >
                {{ section.settings.button_label | escape }}
              </a>
            {%- endif -%}
        </div></div>
    </div>
</div> 
  </div>
  {% endif %}
