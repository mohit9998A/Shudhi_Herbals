<script>

document.addEventListener("DOMContentLoaded", function () {
  // Select all video elements with the section-specific class
  const ctmVideos = document.querySelectorAll(".image-container .ctm-custom-video-{{ section.id }}");

  ctmVideos.forEach((ctmVideo) => {
    console.log("Video element on page:", ctmVideo); // Debugging line

    // Initially hide controls
    ctmVideo.controls = false;

    // Add click event listener to each video
    ctmVideo.addEventListener("click", () => {
      if (ctmVideo.paused) {
        // Pause other videos before playing the current one
        ctmVideos.forEach((otherVideo) => {
          if (otherVideo !== ctmVideo && !otherVideo.paused) {
            otherVideo.pause();
            otherVideo.controls = false; // Hide controls for other videos
          }
        });

        // Play the clicked video and show controls
        ctmVideo.play().then(() => {
          ctmVideo.controls = true;
        }).catch((error) => {
          console.error("Error trying to play video:", error);
        });
      } else {
        // Pause the video and hide controls
        ctmVideo.pause();
        ctmVideo.controls = false;
      }
    });

    // When video ends, hide controls
    ctmVideo.addEventListener("ended", () => {
      ctmVideo.controls = false;
    });
  });

  if (ctmVideos.length === 0) {
    console.log("No video elements found on this page. Skipping video functionality.");
  }
});

