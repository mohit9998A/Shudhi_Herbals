{% comment %} {% if settings.font_type == 'google_fonts' %}

{% assign fonts_1 = false %}
{% if settings.fonts_name_1 != blank %}
{% assign fonts_1 = true %}
{% endif %}




<script type="text/javascript">
  WebFontConfig = {
    google: { families: [ 
      {% if fonts_1 %}
      '{{ settings.fonts_name_1 }}:100,200,300,400,500,600,700,800,900'
      {% endif %}

    ] }
  };
  (function() {
    var wf = document.createElement('script');
    wf.src = ('https:' == document.location.protocol ? 'https' : 'http') +
      '://ajax.googleapis.com/ajax/libs/webfont/1/webfont.js';
    wf.type = 'text/javascript';
    wf.async = 'true';
    var s = document.getElementsByTagName('script')[0];
    s.parentNode.insertBefore(wf, s);
  })(); 
</script>
{% else %}

<link href="https://fonts.googleapis.com/css2?family=Marcellus&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Grand+Hotel&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
<link href='https://fonts.googleapis.com/css?family=Lato' rel='stylesheet'>
<link rel="preconnect" href="https://fonts.gstatic.com">



{% endif %} {% endcomment %}

{% comment %}
  Display + accent faces only: Cormorant Garamond (headings) and Great Vibes
  (the cursive brand accent, .vibes-font). Replaces the old WebFont.js/Barlow
  loader and the unused Marcellus/Grand Hotel/Pacifico/Lato/Josefin/Libre
  Baskerville bundle. See assets/hov-typography.css for the rules.

  The body font is NOT here. It now comes from Shopify's font library via the
  font_picker in Theme settings > Typography, emitted as @font-face by
  layout/theme.liquid — self-hosted on Shopify's CDN, so the body face costs no
  third-party request. Jost was dropped from the URL below when that moved.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Great+Vibes&display=swap">
