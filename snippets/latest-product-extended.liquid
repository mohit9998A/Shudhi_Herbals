@media(max-width:600px){

.ctm-review-text{
  display:-webkit-box;
  -webkit-line-clamp:4;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.ctm-review-text.expanded{
  -webkit-line-clamp:unset;
}

.ctm-read-more{
  display:inline;
}

}

.ctm-read-more {
    border: none;
    background: none;
    color: #6c757d;
    font-size: 13px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    display: none;
    position: relative;
    top: -5px;
  
}
</style>
<script>

document.addEventListener("DOMContentLoaded", function(){

  if(window.innerWidth > 600) return;

  const reviews = document.querySelectorAll(".ctm-review-text");

  reviews.forEach(function(review){

    const button = review.parentElement.querySelector(".ctm-read-more");

    if(review.scrollHeight > review.clientHeight){
      button.style.display = "inline";
    }

    button.addEventListener("click", function(){

      review.classList.toggle("expanded");

      button.innerText = review.classList.contains("expanded") 
      ? "Read less" 
      : "Read more";

    });

  });

});

</script>