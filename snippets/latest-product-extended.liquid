<div class="prod_extended" >
  <section id="content" style="{% if section.settings.spd_style =="pd_extend_background" %}{% if section.settings.display_bg == "dis_bg_img" %}{% if section.settings.bg_prod_extended != blank %}background-image : url({{section.settings.bg_prod_extended|img_url : 'master'}}); background-size : cover {% else %}background-image : url(//via.placeholder.com/1920x1080);background-size : cover {% endif %}{% elsif section.settings.display_bg =="dis_bg_color" %}{% if section.settings.bg_prod_color != blank %}background : {{section.settings.bg_prod_color}} {% else %}background: none {% endif %}	{% endif %}{% endif %}">

    <div class="wrap-bread-crumb">
      <div class="container container-v1">
        <div class="row">
          <div class="col-sm-8">
            {% include 'breadcrumb' %}
          </div>
          <div class="col-sm-4 justify-content-end align-items-center d-sm-flex d-none">
            {% assign found_a_collection = false %}
            {% for c in product.collections %}
            {% if found_a_collection == false and c.handle != 'frontpage' and c.handle != 'all' and c.all_products_count > 1 %}
            {% assign found_a_collection = true %}
            {% assign collection = c %}
            {% endif %}
            {% endfor %}

            <div class="arrows-product">
              {% assign current = product.id %}
              {% if collection and collection.all_products_count >1 %}
              {% for product in collection.products %}
              {% assign id = product.id %}
              {% if id == current %}
              {% if forloop.last %}
              {% assign next = 0 %}
              {% else %}
              {% assign next = forloop.index %}
              {% endif %}
              {% assign prev = forloop.index |minus:2 %}
              {% endif %}
              {% endfor %}
              <div class="prev_prod"  >
                <a href="{{collection.products[prev].url}}"><i class="fa fa-angle-left" aria-hidden="true"></i>{{'products.product.prev' |t}}</a>
                <div class="position-absolute img-prev">
                  <a href="{{collection.products[prev].url}}">
                    <img data-src="{{collection.products[prev].featured_image.src | img_url:"80x80"}}" class="lazyload">
                  </a>
                  <div class="info-prod">
                    <a href="{{collection.products[prev].url}}">{{collection.products[prev].title}}</a>
                    <p >{{collection.products[prev].price|money}}</p>
                  </div>
                </div>
              </div>
              <div class="next_prod" >
                <a href="{{collection.products[next].url}}">
                  {{'products.product.next' |t}}<i class="fa fa-angle-right" aria-hidden="true"></i>
                </a>
                <div class=" img-next">
                  <a href="{{collection.products[next].url}}">
                    <img data-src="{{collection.products[next].featured_image.src | img_url:"80x80"}}" class="lazyload">
                  </a>
                  <div class="info-prod">
                    <a href="{{collection.products[next].url}}" >{{collection.products[next].title}}</a>
                    <p >{{collection.products[next].price|money}}</p>
                  </div>
                </div>
              </div>
              {% else %}
              <a href="#"><i class="prev flaticon-left-arrow position-relative"></i></a>
              <a href="#"><i class="next flaticon-right-arrow position-relative"></i></a>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
    </div>
    <!-- End Bread Crumb -->
    <div class="">
      <div class="content-page container {% if section.settings.spd_style =="pd_extend_background" %} container-v4  {% else %} container-v1{% endif %}">      
        <div class="content-page-detail">
          <div class="row">
            
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
              <div class="image-box">
              <div class="gallery-control">
                {% if section.settings.style_page  == "left" %}
                <div class="row">
                  <div class="col-sm-2 gutter ">
                    <div class="js_prod_sub">
                      {% for image in product.images %}
                      <div class="engoj_img_variant prod_sub thumb_mg engoj-nav-item">
