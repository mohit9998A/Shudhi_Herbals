<div class="menu_moblie hov-mheader-row1 d-flex d-xl-none jsmenumobile align-items-center {% unless settings.enable_sticky_mobile %}engoc-disable-sticky{% endunless %}">

  {%- comment -%} LEFT: brand column — logo + small single-line location, pinned inside Row 1 {%- endcomment -%}
  <div class="hov-mheader-brand">
    <div class="logo_menumoblie hov-mheader-logo">

      {% if settings.logo_svgmobile != blank %}
      <div class="logosvg" style="max-width:{{settings.mobile_logo_maxwidth}}px;">
        <a href="{{shop.url}}">{{settings.logo_svgmobile}}</a>
      </div>
      {% else %}
      <a href="{{shop.url}}">
        {% if settings.logo_mobile != blank %}
        <img src="{{settings.logo_mobile|img_url:'master'}}" width="{{settings.mobile_logo_maxwidth}}" alt="logo">
        {% else %}
        <img src="//via.placeholder.com/150x40" width="{{settings.mobile_logo_maxwidth}}" alt="logo">
        {% endif %}
      </a>
      {% endif %}

    </div>

    <div class="hov-mnav__location d-flex align-items-center">
      <span class="hov-mnav__pin">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
      </span>
      <span class="hov-mnav__pincode"><span data-hov-pincode>141120</span><span data-hov-sep>, </span><span data-hov-city>Ludhiana</span></span>
      <a href="#" class="hov-mnav__verify" data-pincode-modal-trigger>Verify pincodes for accurate delivery
        <svg class="hov-mnav__chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
    </div>
  </div>

  {%- comment -%} RIGHT: cart + hamburger (wishlist + inline search removed — now on bottom nav / Row 2) {%- endcomment -%}
  <div class="menuright hov-mheader-actions">
    <a href="javascript:void(0)" title="" class="js-call-minicart hov-mheader-cart">{% if settings.hd_icon_cart_mb_svg != blank %}{{settings.hd_icon_cart_mb_svg}} {% else %}<i class="{{settings.hd_icon_cart_mb}}"></i>{% endif %}
      <span class="count_pr_incart enj-cartcount{% if cart.item_count == 0 %} hidden-count{% endif %}">{{cart.item_count }}</span>
    </a>
    <a href="javascript:void(0)" title="" class="menuleft hov-mheader-hamburger" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </a>
  </div>
</div>

{%- comment -%} ROW 2: full-width search (normal flow, scrolls away). Same component/JS as desktop. {%- endcomment -%}
<div class="hov-mheader-row2 d-xl-none">
  {% render 'hov-search-bar' with suffix: 'mobile' %}
  <a href="/pages/track-order" class="hov-mheader-trackorder" aria-label="Track your order">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="1" y="3" width="15" height="13" rx="1"/>
      <path d="M16 8h4l3 5v3h-7V8z"/>
      <circle cx="5.5" cy="18.5" r="2.5"/>
      <circle cx="18.5" cy="18.5" r="2.5"/>
    </svg>
  </a>
</div>

{%- comment -%} Mobile-only header layout (matches the mockup). Only renders < xl; the
   desktop header (header-v1) is a separate component, so desktop is untouched. {%- endcomment -%}
<style>
@media (max-width: 1199px) {
  /* ROW 1 — pinned. position:fixed (sticky is impossible: an ancestor .wrap has overflow:hidden).
     !important beats the legacy .engoc-disable-sticky{position:unset} and .menu_mobilescroll rules. */
  .menu_moblie.hov-mheader-row1 {
    position: fixed !important;
    top: var(--hov-promo-height, 32px);   /* sits just below the fixed promo bar */
    left: 0;
    right: 0;
    z-index: 9000;                        /* above content; below promo (9010) & drawers/overlays (9999+) */
    background: #fff;                     /* opaque so the hero doesn't bleed through */
    justify-content: space-between;
    padding: 4px 14px;   /* was 10px — slim Row 1 height ~40% */
    gap: 8px;
  }
  /* ROW 2 — search, normal flow (scrolls away). Clears both fixed bars (promo + Row 1). */
  .hov-mheader-row2 {
    margin-top: calc(var(--hov-promo-height, 32px) + var(--hov-mheader-row1-height, 60px));
    width: 100%;
    background: #fff;
    padding: 5px 14px;              /* was 8px — ~20% row height reduction */
    box-sizing: border-box;
    border-bottom: 1px solid #F0EBE0;
    display: flex;
    align-items: center;
    gap: 10px;                      /* normal spacing between search + track order */
    min-height: 46px;               /* LOCK Row 2 height — pill shrink below can't move the row */
  }
  .hov-mheader-row2 .hov-search__wrapper { max-width: none; flex: 1; min-width: 0; }   /* was width:100% */
  .hov-mheader-row2 .hov-search__form { height: 25px; }   /* was 36px — pill ~30% thinner (desktop pill untouched) */
  .hov-mheader-row2 .hov-search__icon { width: 13px; height: 13px; }   /* 18 × ~0.75, proportional to thinner pill */
  .hov-mheader-row2 .hov-search__input { line-height: 1.1; }           /* keep 14px text tidy in the slimmer pill */
  .hov-mheader-trackorder {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 36px;                   /* >=36px tap floor; matches the pill so it doesn't out-tall the row */
    color: #1A2E1A;                 /* matches the other dark nav icons; drives the SVG currentColor */
  }
  .hov-mheader-trackorder svg { width: 20px; height: 20px; }
  .menu_moblie .menuleft { flex: 0 0 auto; position: relative; z-index: 2; }
  /* Brand column — logo + small single-line location, pinned inside Row 1.
     min-width:0 + overflow:hidden cap the location to available width so it can't widen the navbar. */
  .hov-mheader-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .menu_moblie .logo_menumoblie {
    position: static;
    transform: none;
    left: auto;
    top: auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    max-width: 100%;
    z-index: 1;
  }
  .menu_moblie .logo_menumoblie a img,
  .menu_moblie .logo_menumoblie .logosvg svg,
  .menu_moblie .logo_menumoblie svg {
    width: auto !important;
    max-width: 100%;
    max-height: 26px !important;   /* was 36px — slim Row 1 height ~40% (logo is the dominant height) */
    margin: 0 !important;
  }
  .menu_moblie .menuright {
    flex: 0 0 auto;
    width: auto !important;
    display: flex;
    align-items: center;
    gap: 12px;                     /* was 16px — tighter, single consistent cart+hamburger pair */
    position: relative;
    z-index: 2;
  }
  .menu_moblie .menuright > span,
  .menu_moblie .menuright > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 !important;
    margin: 0 !important;
    color: #1A2E1A;
  }
  .menu_moblie .menuright svg { width: 21px; height: 21px; }
  .menu_moblie .menuright i { font-size: 19px; line-height: 1; color: #1A2E1A; }

  /* Hamburger — reuses the theme's known-correct SVG (same as desktop .hov-nav__hamburger).
     Sized by the existing `.menuright svg { 21px }` rule and colored via currentColor. */
  .menu_moblie .menuright .menuleft {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;              /* overrides base .menuleft{width:70px} so it sits snug by the cart */
  }

  /* Cart badge: stronger red pill with a white ring (matches .hov-sb__quick-badge convention) */
  .menu_moblie .menuright .count_pr_incart {
    position: absolute;
    top: -7px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #E8193C;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #fff;
  }
  .menu_moblie .menuright .enj-cartcount.hidden-count { display: none !important; }

  /* Location — small, thin, single inline line under the logo (inside Row 1) */
  .hov-mnav__location {
    gap: 5px;
    padding: 0;
    margin: 0;
    font-size: 10px;
    background: transparent;
    border-bottom: none;
    flex-wrap: nowrap;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    min-width: 0;
    line-height: 1;              /* tightens the line box to slim Row 1 */
  }
  .hov-mnav__pin { display: inline-flex; align-items: center; color: #C8902A; flex-shrink: 0; }
  .hov-mnav__pin svg { width: 10px; height: 10px; }   /* was 11px */
  .hov-mnav__pincode { font-weight: 600; color: #1A2E1A; flex-shrink: 0; }
  .hov-mnav__verify {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #8A8A8A;
    font-size: 9px;
    text-decoration: none;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hov-mnav__verify:hover { color: #8A8A8A; text-decoration: none; }
  .hov-mnav__chev { flex-shrink: 0; width: 10px; height: 10px; }   /* was 12px */
}
</style>

