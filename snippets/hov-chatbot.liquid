<!-- Shudhi Herbals Chatbot Widget -->
<div id="hov-chat-widget">

  <!-- Toggle Button -->
  <button id="hov-chat-toggle" aria-label="Open chat">
    <span class="hov-chat-icon hov-icon-open">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" fill="currentColor"/>
        <circle cx="8" cy="10" r="1.2" fill="white"/>
        <circle cx="12" cy="10" r="1.2" fill="white"/>
        <circle cx="16" cy="10" r="1.2" fill="white"/>
      </svg>
    </span>
    <span class="hov-chat-icon hov-icon-close">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="hov-chat-badge" id="hov-chat-badge">1</span>
  </button>

  <!-- Chat Window -->
  <div id="hov-chat-window" role="dialog" aria-label="Shudhi Herbals Chat">

    <!-- Header -->
    <div class="hov-chat-header">
      <div class="hov-chat-avatar">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="20" fill="rgba(255,255,255,0.2)"/>
          <path d="M20 8C15 8 11 12 11 17C11 19.5 12 21.7 13.7 23.3L12 30L18.5 27.5C19 27.7 19.5 27.8 20 27.8C25 27.8 29 23.8 29 18.8C29 13 25 8 20 8Z" fill="white"/>
        </svg>
      </div>
      <div class="hov-chat-header-info">
        <div class="hov-chat-name">Shudhi Assistant</div>
        <div class="hov-chat-status">
          <span class="hov-status-dot"></span> Online
        </div>
      </div>
      <button class="hov-chat-close-btn" id="hov-chat-close" aria-label="Close chat">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6L18 18" stroke="white" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Messages -->
    <div class="hov-chat-messages" id="hov-chat-messages">
      <!-- Messages injected by JS -->
    </div>

    <!-- Quick Replies -->
    <div class="hov-quick-replies" id="hov-quick-replies">
      <!-- Injected by JS -->
    </div>

    <!-- Input -->
    <div class="hov-chat-input-bar">
      <input
        type="text"
        id="hov-chat-input"
        placeholder="Type a message..."
        autocomplete="off"
        maxlength="200"
      />
      <button id="hov-chat-send" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div>
</div>

