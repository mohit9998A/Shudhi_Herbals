  /* ========================================================
     STATE
  ======================================================== */
  var isOpen = false;
  var badgeShown = true;
  var typingTimer = null;

  /* ========================================================
     DOM REFS
  ======================================================== */
  var toggle   = document.getElementById('hov-chat-toggle');
  var window_  = document.getElementById('hov-chat-window');
  var messages = document.getElementById('hov-chat-messages');
  var qrBar    = document.getElementById('hov-quick-replies');
  var input    = document.getElementById('hov-chat-input');
  var sendBtn  = document.getElementById('hov-chat-send');
  var closeBtn = document.getElementById('hov-chat-close');
  var badge    = document.getElementById('hov-chat-badge');

  /* ========================================================
     HELPERS
  ======================================================== */
  function escapeHtml(text) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(text));
    return div.innerHTML;
  }

  function formatMessage(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*\n]+?)\*(?!\*)/g, '$1<em>$2</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/\n/g, '<br>');
  }

  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }

  /* ========================================================
     RENDER MESSAGES
  ======================================================== */
  function addMessage(text, sender) {
    var div = document.createElement('div');
    div.className = 'hov-msg hov-msg--' + sender;

    var bubble = document.createElement('div');
    bubble.className = 'hov-bubble';
    bubble.innerHTML = formatMessage(text);

    div.appendChild(bubble);
    messages.appendChild(div);
    scrollToBottom();
    return div;
  }

  function showTyping() {
    var div = document.createElement('div');
    div.className = 'hov-msg hov-msg--bot hov-typing-row';
    div.id = 'hov-typing';
    div.innerHTML = '<div class="hov-bubble hov-typing"><span></span><span></span><span></span></div>';
    messages.appendChild(div);
    scrollToBottom();
  }

  function removeTyping() {
    var t = document.getElementById('hov-typing');
    if (t) t.parentNode.removeChild(t);
  }

  /* ========================================================
     RENDER QUICK REPLIES
  ======================================================== */
  function renderReplies(replies) {
    qrBar.innerHTML = '';
    if (!replies || replies.length === 0) return;

    replies.forEach(function (r) {
      var btn = document.createElement('button');
      btn.className = 'hov-qr-btn';
      btn.textContent = r.label;
      btn.addEventListener('click', function () {
        handleReply(r.label, r.flow);
      });
      qrBar.appendChild(btn);
    });
  }

  /* ========================================================
     FLOW ENGINE
  ======================================================== */
  function goToFlow(flowKey) {
    var flow = FLOWS[flowKey];
    if (!flow) return;

    renderReplies([]);   // clear while typing
    showTyping();

    var delay = 600 + Math.min(flow.message.length * 2, 800);
    typingTimer = setTimeout(function () {
      removeTyping();
      addMessage(flow.message, 'bot');
      renderReplies(flow.replies);
    }, delay);
  }

  function handleReply(label, flowKey) {
    addMessage(label, 'user');
    goToFlow(flowKey);
  }

  /* ========================================================
     USER TEXT INPUT — simple keyword matching
  ======================================================== */
  var KEYWORDS = [
    { words: ['product','item','bar','soap','cleans','cleansing','skin','aura','ingredient','allergen','herbal','fragrance','scent','how to use','pack','100g','size'], flow: 'products' },
    { words: ['ship','deliver','cod','cash on delivery','arrival','arrive','track','dispatch','pincode','free ship'], flow: 'shipping' },
    { words: ['return','refund','replace','damaged','wrong item','exchange','broken'], flow: 'returns' },
    { words: ['offer','discount','coupon','code','deal','sale','promo','bulk','gift','gifting','loyalty','referral'], flow: 'offers' },
    { words: ['contact','email','phone','call','address','office','help','support'], flow: 'contact' },
    { words: ['hello','hi','hey','helo','namaste','start','menu'], flow: 'main' }
  ];

  function matchKeyword(text) {
    var lower = text.toLowerCase();
    for (var i = 0; i < KEYWORDS.length; i++) {
      var group = KEYWORDS[i];
      for (var j = 0; j < group.words.length; j++) {
        if (lower.indexOf(group.words[j]) !== -1) {
          return group.flow;
        }
      }
    }
    return null;
  }

  function handleUserInput() {
    var text = input.value.trim();
    if (!text) return;
    input.value = '';

    addMessage(text, 'user');

    var flow = matchKeyword(text);
    if (flow) {
      goToFlow(flow);
    } else {
      showTyping();
      setTimeout(function () {
        removeTyping();
        addMessage(
          "I'm not sure about that, but I'm happy to help! 😊\nPlease choose a topic below or email us at [help@shudhiherbals.com](mailto:help@shudhiherbals.com)",
          'bot'
        );
        renderReplies(FLOWS.main.replies);
      }, 800);
    }
  }

  /* ========================================================
     OPEN / CLOSE
  ======================================================== */
  function openChat() {
    isOpen = true;
    window_.classList.add('hov-chat-open');
    toggle.classList.add('hov-toggle-open');
    badge.style.display = 'none';
    badgeShown = false;
    input.focus();
  }

  function closeChat() {
    isOpen = false;
    window_.classList.remove('hov-chat-open');
    toggle.classList.remove('hov-toggle-open');
  }

  /* ========================================================
     EVENTS
  ======================================================== */
  toggle.addEventListener('click', function () {
    isOpen ? closeChat() : openChat();
  });

  closeBtn.addEventListener('click', closeChat);

  sendBtn.addEventListener('click', handleUserInput);

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') handleUserInput();
  });

  /* ========================================================
     WATCH FOR OPEN MENUS/DRAWERS TO HIDE CHATBOT
  ======================================================== */
  function updateChatbotVisibility() {
    var minicartActive = document.querySelector('.js-minicart.active') || document.querySelector('.bg-minicart.active');
    var mobileMenuActive = document.body.classList.contains('activemenu_mobile') || document.body.classList.contains('activemenu_mobile_right') || document.querySelector('.box_contentmenu.active');
    var searchActive = document.querySelector('.bg_search_box.active');

    if (minicartActive || mobileMenuActive || searchActive) {
      toggle.style.opacity = '0';
      toggle.style.visibility = 'hidden';
      toggle.style.pointerEvents = 'none';
      if (isOpen) {
        closeChat();
      }
    } else {
      toggle.style.opacity = '';
      toggle.style.visibility = '';
      toggle.style.pointerEvents = '';
    }
  }

  if (window.MutationObserver) {
    var observer = new MutationObserver(function() {
      updateChatbotVisibility();
    });
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ['class'],
      subtree: true
    });
  }
  
  document.addEventListener('click', function() {
    setTimeout(updateChatbotVisibility, 100);
    setTimeout(updateChatbotVisibility, 350);
  });

  updateChatbotVisibility();

  /* ========================================================
     INIT — show greeting after 1.5s
  ======================================================== */
  setTimeout(function () {
    goToFlow('main');
  }, 300);

  /* Show badge notification after 4s if not opened */
  setTimeout(function () {
    if (!isOpen && badgeShown) {
      badge.style.display = 'flex';
    }
  }, 4000);

})();
</script>
