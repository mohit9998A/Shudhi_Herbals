<!-- /snippets/breadcrumb.liquid -->
{% comment %}
Documentation - http://docs.shopify.com/support/your-website/navigation/creating-a-breadcrumb-navigation
{% endcomment %}

{% unless template == 'index' %}
{% if template contains 'product' %}
  <nav class="bread-crumb hov-breadcrumb" aria-label="Breadcrumb">
    {% if settings.enable_rtl_mode %}
      <span class="hov-breadcrumb__current">{{ product.title }}</span>
      <span class="hov-breadcrumb__sep">‹</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {% else %}
        {% assign fallback_collection = nil %}
        {% for c in product.collections %}
          {% if fallback_collection == nil and c.handle != 'frontpage' and c.handle != 'all' %}
            {% assign fallback_collection = c %}
          {% endif %}
        {% endfor %}
        {% if fallback_collection %}
          <a href="{{ fallback_collection.url }}">{{ fallback_collection.title }}</a>
        {% endif %}
      {% endif %}
      <span class="hov-breadcrumb__sep">‹</span>
      <a href="/" title="{{ 'general.breadcrumbs.home_link_title' | t }}">{{ 'general.breadcrumbs.home' | t }}</a>
    {% else %}
      <a href="/" title="{{ 'general.breadcrumbs.home_link_title' | t }}">{{ 'general.breadcrumbs.home' | t }}</a>
      <span class="hov-breadcrumb__sep">›</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {% else %}
        {% assign fallback_collection = nil %}
        {% for c in product.collections %}
          {% if fallback_collection == nil and c.handle != 'frontpage' and c.handle != 'all' %}
            {% assign fallback_collection = c %}
          {% endif %}
        {% endfor %}
        {% if fallback_collection %}
          <a href="{{ fallback_collection.url }}">{{ fallback_collection.title }}</a>
        {% endif %}
      {% endif %}
      <span class="hov-breadcrumb__sep">›</span>
      <span class="hov-breadcrumb__current">{{ product.title }}</span>
    {% endif %}
  </nav>
{% else %}
  {% if settings.enable_rtl_mode %}
  <div class="bread-crumb">
    {% if template contains 'collection' and collection.handle %}
    {% if current_tags %}
    {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
    {{ collection.title | link_to: url }}
    {% else %}
    <strong>{{ collection.title }}</strong>
    {% endif %}

    {% elsif template == 'blog' %}
    {% if current_tags %}
    {{ blog.title | link_to: blog.url }}
    {% else %}
    <strong>{{ blog.title }}</strong>
    {% endif %}

    {% elsif template == 'article' %}
    <strong>{{ article.title }}</strong>
    <a href="{{ blog.url}}"><i class="fa fa-angle-left" aria-hidden="true"></i> {{blog.title}}</a>

    {% elsif template contains 'page' %}
    <strong>{{ page.title }}</strong>

    {% else %}
    <strong>{{ page_title }}</strong>

    {% endif %}
    <a href="/" title="{{ 'general.breadcrumbs.home_link_title' | t }}"><i class="fa fa-angle-left" aria-hidden="true"></i>{{ 'general.breadcrumbs.home' | t }}</a>
  </div>
  {% else %}
  <div class="bread-crumb">
    <a href="/" title="{{ 'general.breadcrumbs.home_link_title' | t }}">{{ 'general.breadcrumbs.home' | t }}<i class="fa fa-angle-right" aria-hidden="true"></i></a>
    {% if template contains 'collection' and collection.handle %}
    {%- comment -%}Resolve parent category for sidebar sub-collections{%- endcomment -%}
    {%- assign hov_bc_parent_title = '' -%}
    {%- assign hov_bc_parent_url = '' -%}
    {%- assign hov_staple_sub = 'organic-pulses-and-beans,organic-sweeteners,organic-cooking-oils,millets,salt-seasonings,organic-poha,organic-peanut' | split: ',' -%}
    {%- for _hbc in hov_staple_sub -%}
      {%- if collection.handle == _hbc -%}
        {%- assign hov_bc_parent_title = '[PLACEHOLDER — category]' -%}
        {%- assign hov_bc_parent_url = '/collections/all' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if collection.handle == 'himalayan-shilajit' -%}
      {%- assign hov_bc_parent_title = '[PLACEHOLDER — category]' -%}
      {%- assign hov_bc_parent_url = '/collections/all' -%}
    {%- endif -%}
    {%- if hov_bc_parent_title != '' -%}
      <a href="{{ hov_bc_parent_url }}">{{ hov_bc_parent_title }}</a>
      <i class="fa fa-angle-right" aria-hidden="true"></i>
    {%- endif -%}
    {% if current_tags %}
    {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
    {{ collection.title | link_to: url }}
    <strong>{{ current_tags | join: " + " }}</strong>
    {% else %}
    <strong>{{ collection.title }}</strong>
    {% endif %}

    {% elsif template == 'blog' %}
    {% if current_tags %}
    {{ blog.title | link_to: blog.url }}
    <strong>{{ current_tags | join: " + " }}</strong>
    {% else %}
    <strong>{{ blog.title }}</strong>
    {% endif %}

    {% elsif template == 'article' %}
    <a href="{{ blog.url}}">{{blog.title}} <i class="fa fa-angle-right" aria-hidden="true"></i></a>
    <strong>{{ article.title }}</strong>

    {% elsif template contains 'page' %}
    <strong>{{ page.title }}</strong>

    {% else %}
    <strong>{{ page_title }}</strong>

    {% endif %}
  </div>
  {% endif %}
{% endif %}
{% endunless %}
