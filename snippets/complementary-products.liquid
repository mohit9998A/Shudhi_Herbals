<script src="{{ 'complementary-products.js'| asset_url  }}" defer="defer"></script>
{% for collection in product.collections %}
  {% assign complementary_products = collection.metafields.custom.complementary_product.value %}
  {% if complementary_products %}
<div class="complementary-1">
  {% if block.settings.title != blank %}
  <h5 class="title">{{ block.settings.title }}</h5>
    {% endif %}
    <div class="com-pro">
      <input type="hidden" id="cart_type" value="{{ settings.cart_type }}">
       {% for product in complementary_products limit:3 %} 
            <div class="product-card">
                   <a href="{{ product.url }}">
                     <div class="image">
                       <img class="lazyload" data-src="{{ product.featured_image | img_url: 'master' }}">
                       <label class="container-1">
                        <input type="checkbox" name="bundle_pair" value="{{ product.variants.first.id }}">
                        <span class="checkmark"></span>
                      </label>
                     </div>
                     <div class="info9">
                       <h3>{{ product.title }}</h3>
                      <p>{{ product.metafields.custom.short_description1 | metafield_tag | strip_html | escape | truncate : 20 }}</p>
                      <div class="main_pricce">
                       <div class="c-price">
                         <s>{{ product.compare_at_price | money_with_currency }}</s>
                       </div>
                       <div class="price">
                         {{ product.price | money_with_currency }}
                       </div>
                      </div>
                     </div>
                   </a>
                 </div>
         {% endfor %}
     </div> 
    <div class="btn">
          <a href="javascript:void(0);" class="add_to_cartt">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="23" viewBox="0 0 24 23" fill="none">
          <path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6M10 21C10 21.5523 9.55228 22 9 22C8.44772 22 8 21.5523 8 21C8 20.4477 8.44772 20 9 20C9.55228 20 10 20.4477 10 21ZM21 21C21 21.5523 20.5523 22 20 22C19.4477 22 19 21.5523 19 21C19 20.4477 19.4477 20 20 20C20.5523 20 21 20.4477 21 21Z" stroke="#fff" style="stroke:#fff;stroke-opacity:1;" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
            Add all <span class="count_product"></span> items to cart
          </a>
    </div>
</div>
 {% endif %}
{% endfor %}

