<div class="article_sidebar"> 
  {% if section.settings.enable_widget_search %}
  <div class="widget widget-search">
    <form class="wg-search-form" action="/search">
      <input type="hidden" name="type" value="product">
      <input type="text" placeholder="{{section.settings.shop_by_search_placeholder}}" name="q" value="{{ search.terms | escape }}"  />
      <button type="submit" value=""><i class="fa fa-search" aria-hidden="true"></i></button>
    </form>

  </div>
  {% endif %}
<div id="toc-container" class="desktop-hide">
  <strong>Table of Contents</strong>
  <ul id="toc-lists--{{ section.id }}"></ul>
</div>
  {% if section.settings.enable_widget_cate %}
  <div class="blog_sidebar_cate">
    <h2 class="widget-title">{{section.settings.widget_cate_title}}</h2>
    <div class="widget-content">
      <ul class="list-category-toggle">
        {% for link in linklists[section.settings.widget_cate_menu].links %}
        <li class="item-toggle-tab"><a style="padding: 8px 0;display: block;" href="{{ link.url }}">{{link.title | split: '[' | first }}</a></li>

        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  {% if section.settings.enable_widget_related %}
  {%- assign posts_limit = section.settings.blogs_limit | default: 5 -%}
  {%- assign recent_blog = blogs[section.settings.select_blog] -%}
  {%- assign recent_count = recent_blog.articles_count | default: 0 -%}
  {%- if recent_count == 0 -%}
    {%- assign recent_blog = blog -%}
    {%- assign recent_count = blog.articles_count | default: 0 -%}
  {%- endif -%}
  {% if recent_count > 0 %}
  <div class="blog_sidebar_recent">
    <h2 class="widget-title ">{{section.settings.widget_related_title}}</h2>
    <div class="list-posts">
      {% for article in recent_blog.articles limit: posts_limit %}
      <div class="item-post">
        <div class="post-thumb "><a href="{{ article.url }}" class="">
          {%- if article.image -%}
          <img src="{{ article.image | img_url: '160x160', crop: 'center' }}" alt="{{ article.title | escape }}" loading="lazy" />
          {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a></div>
        <div class="post-info">
          <span class="date-post">{{ article.published_at | date: "%d.%B.%Y" }}</span>
          <h3 class="post-title mb-0 "><a href="{{ article.url }}" class="dark">{{ article.title }}</a></h3>
          <span class="comment-count silver">{{article.comments_count}} Comments</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% endif %}

  {% if section.settings.enable_widget_tag %}
  <div class="widget widget-tags">
    <h2 class="widget-title">{{section.settings.shop_by_tag_title}}</h2>
    <ul class="list-tag">
      {% if blog.all_tags.size > 0 %}
      {% for tag in blog.all_tags %}
      {% if current_tags contains tag %}
      <li>{{ tag }}</li>
      {% else %}
      <li>{{ tag | link_to_tag: tag }}</li>
      {% endif %}
      {% endfor %}
      {% endif %}
    </ul>
  </div>
  {% endif %}
  
  <div class="banner_sidebar ">
    <a href="{{section.settings.banner_article_url}}" target="_blank">
      <img class="w-100" src="{% if section.settings.banner_article_sidebar != blank %} {{section.settings.banner_article_sidebar |img_url :'master'}} {% else %} //via.placeholder.com/320x480{% endif %}">
    </a>
  </div>
</div>
<style>
.Article__Body h2 {
    scroll-margin-top: 150px;
}
div#toc-container {
    padding: 8px;
    background: transparent;
    margin: 10px;
}
  .article_sidebar .desktop-hide ul {
    padding: 0;
}
.article_sidebar .desktop-hide ul a {
    font-weight: 400;
}

.desktop-hide strong {
    font-weight: 700;
    margin-left: -18px;
}
@media (max-width: 767px){
    .desktop-hide {
    display: none;
}
div#toc-container {
    margin-left: 0;
    margin-right: 0;
    padding: 10px;
}
  div#toc-container {
    margin-top: 15px;
    margin-bottom: 15px;
}
}

</style>
<script>

$(document).ready(function () {
  // $('html').css('scroll-behavior', 'smooth');
  // Select article content (common class in Shopify themes)
  var $article = $(".Rte, .Article__Body").first();
  var $tocList = $("#toc-list--{{ section.id }},#toc-lists--{{ section.id }}");

  // If not found, exit
  if ($article.length === 0 || $tocList.length === 0) return;

  // Find headings inside the article
  $article.find("h2").each(function (index) {
    var $heading = $(this);
    var id = $heading.attr("id");

    if (!id) {
      id = "toc-heading-" + index;
      $heading.attr("id", id);
    }

    // Append to TOC list
    $tocList.append(
      $("<li>").append(
        $("<a>")
          .attr("href", "#" + id)
          .text($heading.text())
      )
    );
  });
});


</script>
<style>
@media (min-width: 1025px) {
  .mobile-hide {
    display: none;
  }
}

</style>