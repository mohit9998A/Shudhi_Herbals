{%- assign wl_url = settings.url_wishlist | default: '/pages/wishlist' -%}
<nav class="menu_toolbar hov-bottomnav d-flex d-sm-none" aria-label="Primary mobile navigation">

  <a href="/" class="hov-bottomnav__tab{% if request.page_type == 'index' %} is-active{% endif %}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/collections/all" class="hov-bottomnav__tab{% if request.page_type == 'collection' %} is-active{% endif %}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M6 2L3 6v14a2 2 0 002 2h14 a2 2 0 002-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 01-8 0"/>
    </svg>
    <span>Shop</span>
  </a>

  <a href="{{ wl_url }}" class="hov-bottomnav__tab{% if request.path == wl_url %} is-active{% endif %}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0 L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23 l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
    </svg>
    <span>Wishlist</span>
    <span class="hov-wish__nav-count hov-bottomnav__badge" style="display:none">0</span>
  </a>

  {% if customer %}
    <a href="/account" class="hov-bottomnav__tab{% if request.page_type == 'customers/account' %} is-active{% endif %}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M20 21v-2a4 4 0 00-4-4H8 a4 4 0 00-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      <span>Account</span>
    </a>
  {% else %}
    <a href="/account/login" class="hov-bottomnav__tab js-call-popup-login" data-login-trigger>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M20 21v-2a4 4 0 00-4-4H8 a4 4 0 00-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      <span>Account</span>
    </a>
  {% endif %}
</nav>

<style>
@media (max-width: 575.98px) {
  .hov-bottomnav__tab {
    flex: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 3px; height: 100%;
    font-size: 10px; line-height: 1;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    position: relative;
  }
  .hov-bottomnav__tab svg { width: 20px; height: 20px; display: block; }
  .hov-bottomnav__tab span { line-height: 1; }
  .hov-bottomnav__tab.is-active { color: #F5B940; }
  /* Wishlist badge: reuse .hov-wish__nav-count (JS-synced by hov-wishlist.js); position + style scoped to the tab */
  .menu_toolbar .hov-bottomnav__tab .hov-wish__nav-count {
    position: absolute; top: 2px; left: calc(50% + 2px); right: auto;
    min-width: 15px; height: 15px; padding: 0 3px;
    background: #E8193C; color: #fff;
    font-size: 9px; font-weight: 700; line-height: 1;
    border-radius: 999px; border: 1.5px solid {{ settings.color_main }};
    align-items: center; justify-content: center;
  }
}
</style>
